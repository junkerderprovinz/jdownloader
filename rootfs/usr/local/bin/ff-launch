#!/bin/sh
# Firefox launcher for JDownloader's browser actions (captcha "open in browser",
# help links), used only when JD_ENABLE_BROWSER is on. JD opens URLs through
# xdg-open, gio and the firefox .desktop Exec, which points here.
#
# JD starts xdg-open with a ProcessBuilder that hands the child chain JD's own
# stdout/stderr pipe. Firefox inherits it and writes startup warnings to it (libEGL,
# DRI3 and sandbox noise on this GPU-less display). Once JD reaps the short-lived
# xdg-open, the pipe's read end closes and Firefox dies of SIGPIPE on its next
# write, seconds after it opened. With its stdio on /dev/null it keeps running.
exec firefox "$@" >/dev/null 2>&1 </dev/null
