#!/bin/sh
# Openbox runs this with /bin/sh, so no bash syntax.
# Launches JDownloader in a loop. The first start bootstraps and installs JD2, which
# needs a live DISPLAY; a self-update (SmartRlyExitRequest), a normal exit or a crash
# all end in a restart.

export LANG="${LANG:-en_US.UTF-8}"
export LANGUAGE="${LANGUAGE:-en_US:en}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

# cont-init writes BROWSER and XDG_CURRENT_DESKTOP into the s6 container environment,
# but svc-de, which launches this JVM, does not depend on that oneshot, so on some
# boots the session starts before the write and JD has no browser handler (AppWork
# "Unsupported OpenBrowser"). Deriving them here, in the JVM's direct parent, makes
# sure they are inherited. The /config sentinel covers a recreate that dropped
# JD_ENABLE_BROWSER.
case "${JD_ENABLE_BROWSER:-}" in
    [Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|1|[Oo][Nn]) _jd_browser=1 ;;
    *) [ -f /config/.jd-browser-enabled ] && _jd_browser=1 || _jd_browser=0 ;;
esac
if [ "${_jd_browser}" = "1" ]; then
    export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-XFCE}"
    export BROWSER="${BROWSER:-/usr/local/bin/ff-launch}"
fi

# Selkies streams the X display as one H.264 video that the browser scales, so
# zooming the browser blurs the text. JD_UI_SCALE makes Swing render the whole UI
# larger at full pixel density instead, which keeps text sharp with the browser at
# 100%. Empty keeps 1x; typical values are 1.25, 1.5 and 2.
JD_UI_SCALE_OPT=""
case "${JD_UI_SCALE:-}" in
    "") : ;;
    *[!0-9.]*) echo "[jdownloader-autostart] ignoring invalid JD_UI_SCALE='${JD_UI_SCALE}' (use a number like 1.5)" >&2 ;;
    *) JD_UI_SCALE_OPT="-Dsun.java2d.uiScale=${JD_UI_SCALE}"
       echo "[jdownloader-autostart] JD_UI_SCALE=${JD_UI_SCALE} -> HiDPI Swing scaling enabled (crisp text without browser zoom)" >&2 ;;
esac

# The desktop background follows the theme: Carbon for Dark, light grey for Light
# and a soft blue-grey for classic JDDEFAULT.
_case_theme=$(printf '%s' "${JD_THEME:-Dark}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | tr '[:upper:]' '[:lower:]')
case "${_case_theme}" in
    light|jd_plain) xsetroot -solid '#f2f2f2' 2>/dev/null || true ;;
    jddefault)      xsetroot -solid '#d7e7f0' 2>/dev/null || true ;;
    *)              xsetroot -solid '#161616' 2>/dev/null || true ;;
esac
unset _case_theme

JD_DIR="${JD_INST_DIR:-/config/JDownloader}"
LAUNCHER="${JD_DIR}/JDownloader.jar"

# The LAF class fragment JD should end up with, following jdownloader-theme.sh's
# JD_THEME mapping; classic JDDEFAULT expects none. The helper resolves every casing
# the same way, so a differently spelled theme cannot leave JD on Metal.
HELPERS="/usr/local/bin/jdownloader-laf-helpers.py"
EXPECT_LAF="flatdark"
EXPECT_CLASSIC=0
if [ -f "${HELPERS}" ]; then
    _resolved=$(python3 "${HELPERS}" resolve "${JD_THEME:-Dark}")
    EXPECT_LAF=$(printf '%s\n' "${_resolved}" | awk -F= '/^expect_laf=/{print $2; exit}')
    EXPECT_CLASSIC=$(printf '%s\n' "${_resolved}" | awk -F= '/^expect_classic=/{print $2; exit}')
    unset _resolved
else
    THEME_LC=$(printf '%s' "${JD_THEME:-Dark}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | tr '[:upper:]' '[:lower:]')
    case "${THEME_LC}" in
        jddefault) EXPECT_LAF=""; EXPECT_CLASSIC=1 ;;
        light|jd_plain) EXPECT_LAF="flatlight"; EXPECT_CLASSIC=0 ;;
        *dark*) EXPECT_LAF="flatdark"; EXPECT_CLASSIC=0 ;;
        *) EXPECT_LAF="flatdark"; EXPECT_CLASSIC=0 ;;
    esac
fi
: "${EXPECT_CLASSIC:=0}"
# An empty EXPECT_LAF is only valid for classic. After a failed resolve,
# laf_matches() would otherwise accept Metal as ready for Dark and Light.
if [ "${EXPECT_CLASSIC}" = "1" ]; then
    EXPECT_LAF=""
else
    : "${EXPECT_LAF:=flatdark}"
fi

# Requests the FlatLaf themes extension in JD's update registry. JD's LookAndFeelType
# maps every FlatLaf theme to the extension id "flatlaf-themes", and the request list
# is a plain JSON array in update/versioninfo/JD/extensions.requestedinstalls.json.
# The package still arrives only on the first GUI start, through the design-install
# dialog the agent confirms, since a headless run does not fetch it. A truncated
# flatlaf.jar keeps the request alive.
seed_flatlaf_request() {
    # Seeded even on JDDEFAULT so a later switch to Dark or Light works; a jar parked
    # for classic does not count.
    if flatlaf_jar_valid "${JD_DIR}/libs/laf/flatlaf.jar"; then
        return 0
    fi
    python3 - "${JD_DIR}/update/versioninfo/JD/extensions.requestedinstalls.json" <<'PYEOF' >&2 || true
import json, os, sys
path = sys.argv[1]
ids = []
if os.path.exists(path):
    try:
        ids = json.load(open(path))
        if not isinstance(ids, list):
            ids = []
    except Exception:
        ids = []
if "flatlaf-themes" not in ids:
    ids.append("flatlaf-themes")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    json.dump(ids, open(path, "w"))
    print("[jdownloader-autostart] requested flatlaf-themes extension install (the updater will fetch it)")
else:
    # For example after a switch from JDDEFAULT to Light on a classic-only install.
    print("[jdownloader-autostart] flatlaf-themes already requested, waiting for flatlaf.jar (avoids Metal until it arrives)")
PYEOF
}

# Classic JDDEFAULT needs synthetica.jar, syntheticaJDCustom.jar and the licence.
# Without both jars SyntheticaHelper or JDDefaultLookAndFeel fails and JD falls back
# to MetalLookAndFeel. In upstream JD the optional Synthetica skins map to the
# extension id "synthetica-themes", LookAndFeelType.DEFAULT maps to none, and
# libs/laf/synthetica.dep.json names the package "synthetica" for synthetica.jar
# itself, so both ids are requested.
seed_synthetica_request() {
    [ "${EXPECT_CLASSIC}" = "1" ] || return 0
    # Core alone is not enough, so seeding goes on until both jars are valid.
    if [ -f "${HELPERS}" ]; then
        python3 "${HELPERS}" classic-jars-ready "${JD_DIR}/libs/laf" && return 0
        python3 "${HELPERS}" seed-synthetica \
            "${JD_DIR}/update/versioninfo/JD/extensions.requestedinstalls.json" \
            "${JD_DIR}/libs/laf" \
            "${JD_DIR}/update/versioninfo/JD/extensions.installed.json" >&2 || true
        return 0
    fi
    [ -f "${JD_DIR}/libs/laf/synthetica.jar" ] \
        && [ -f "${JD_DIR}/libs/laf/syntheticaJDCustom.jar" ] && return 0
    python3 - "${JD_DIR}/update/versioninfo/JD/extensions.requestedinstalls.json" <<'PYEOF' >&2 || true
import json, os, sys
path = sys.argv[1]
ids = []
if os.path.exists(path):
    try:
        ids = json.load(open(path))
        if not isinstance(ids, list):
            ids = []
    except Exception:
        ids = []
changed = False
for ext in ("synthetica", "synthetica-themes"):
    if ext not in ids:
        ids.append(ext)
        changed = True
if changed:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    json.dump(ids, open(path, "w"))
    print("[jdownloader-autostart] requested synthetica extension(s) for classic JDDEFAULT")
PYEOF
}

# True when flatlaf.jar is a readable zip that contains the FlatLaf classes. A
# truncated write, for example when the pre-install kill chain stops the updater
# mid-download, leaves a jar that fails every boot with ClassNotFoundException:
# com.formdev.flatlaf.FlatDarkLaf and a light GUI.
flatlaf_jar_valid() {
    if [ -f "${HELPERS}" ]; then
        python3 "${HELPERS}" flatlaf-valid "$1"
        return $?
    fi
    python3 - "$1" <<'PYEOF'
import sys, zipfile
try:
    z = zipfile.ZipFile(sys.argv[1])
    z.getinfo("com/formdev/flatlaf/FlatDarkLaf.class")
    sys.exit(1 if z.testzip() is not None else 0)
except Exception:
    sys.exit(1)
PYEOF
}

# The same check for synthetica*.jar, where a truncated download means Metal on
# every start.
synthetica_jar_valid() {
    if [ -f "${HELPERS}" ]; then
        python3 "${HELPERS}" synthetica-valid "$1"
        return $?
    fi
    python3 - "$1" <<'PYEOF'
import sys, zipfile
try:
    z = zipfile.ZipFile(sys.argv[1])
    z.getinfo("de/javasoft/plaf/synthetica/SyntheticaLookAndFeel.class")
    sys.exit(1 if z.testzip() is not None else 0)
except Exception:
    sys.exit(1)
PYEOF
}

any_synthetica_valid() {
    if [ -f "${HELPERS}" ]; then
        python3 "${HELPERS}" any-synthetica-valid "${JD_DIR}/libs/laf"
        return $?
    fi
    for j in "${JD_DIR}/libs/laf"/synthetica*.jar; do
        [ -f "${j}" ] || continue
        synthetica_jar_valid "${j}" && return 0
    done
    return 1
}

# Classic needs a valid core synthetica.jar and syntheticaJDCustom.jar.
classic_jars_ready() {
    if [ -f "${HELPERS}" ]; then
        python3 "${HELPERS}" classic-jars-ready "${JD_DIR}/libs/laf"
        return $?
    fi
    [ -f "${JD_DIR}/libs/laf/synthetica.jar" ] || return 1
    [ -f "${JD_DIR}/libs/laf/syntheticaJDCustom.jar" ] || return 1
    synthetica_jar_valid "${JD_DIR}/libs/laf/synthetica.jar" || return 1
    return 0
}

# An existing install that switches from Dark or Light to JDDEFAULT skips the
# fresh-install headless block, so the Synthetica jars would be missing when the GUI
# starts and JD would open on Metal. One headless updater pass fetches them first.
bootstrap_classic_jars_if_needed() {
    [ "${EXPECT_CLASSIC}" = "1" ] || return 0
    [ -f "${JD_DIR}/Core.jar" ] || return 0
    classic_jars_ready && return 0
    [ -f /tmp/.jd-classic-bootstrap-tried ] && return 0
    : > /tmp/.jd-classic-bootstrap-tried

    echo "[jdownloader-autostart] JDDEFAULT selected but Synthetica jars not ready, running a headless updater pass (avoids Metal on template switch)..." >&2
    ensure_synthetica_license
    heal_invalid_synthetica
    seed_synthetica_request

    rm -f /tmp/.jd-agent.pid /tmp/.jd-laf-applied /tmp/.jd-laf-restart-request
    java -Djava.awt.headless=true -jar "${LAUNCHER}" < /dev/null >> /config/jd-classic-bootstrap.log 2>&1 &
    tries=0
    settle=0
    while [ "${tries}" -lt 90 ]; do
        sleep 10
        tries=$((tries + 1))
        seed_synthetica_request
        if classic_jars_ready; then
            settle=$((settle + 1))
        else
            settle=0
        fi
        [ "${settle}" -ge 3 ] && break
    done
    if classic_jars_ready; then
        echo "[jdownloader-autostart] classic Synthetica jars ready after headless bootstrap" >&2
    else
        echo "[jdownloader-autostart] classic jars still missing after 15 min headless bootstrap; the GUI start will retry seed/heal" >&2
    fi
    pkill -TERM -f "JDownloader\.jar" 2>/dev/null || true
    w=0
    while pgrep -f "JDownloader\.jar" > /dev/null 2>&1 && [ "${w}" -lt 12 ]; do
        sleep 5
        w=$((w + 1))
    done
    pkill -KILL -f "JDownloader\.jar" 2>/dev/null || true
    rm -f /tmp/.jd-agent.pid /tmp/.jd-laf-applied /tmp/.jd-laf-restart-request
}

# The FlatLaf counterpart: an existing install switching to Dark or Light without
# flatlaf.jar fetches it headless before the GUI, so JD does not open on Metal.
bootstrap_flatlaf_if_needed() {
    [ -n "${EXPECT_LAF}" ] || return 0
    [ -f "${JD_DIR}/Core.jar" ] || return 0
    # A JDDEFAULT run parks flatlaf.jar under this name (see the EXPECT_CLASSIC
    # branch of the launch loop). Restoring it before the validity check saves a
    # headless bootstrap of about 3 minutes for a jar that is already there.
    if [ -f "${JD_DIR}/libs/laf/flatlaf.jar.disabled-for-classic" ] && [ ! -f "${JD_DIR}/libs/laf/flatlaf.jar" ]; then
        mv -f "${JD_DIR}/libs/laf/flatlaf.jar.disabled-for-classic" "${JD_DIR}/libs/laf/flatlaf.jar" 2>/dev/null || true
        echo "[jdownloader-autostart] re-enabled flatlaf.jar for FlatLaf theme (was parked from a previous classic run)" >&2
    fi
    flatlaf_jar_valid "${JD_DIR}/libs/laf/flatlaf.jar" && return 0
    [ -f /tmp/.jd-flatlaf-bootstrap-tried ] && return 0
    : > /tmp/.jd-flatlaf-bootstrap-tried

    echo "[jdownloader-autostart] FlatLaf theme selected but flatlaf.jar missing, fetching the extension headless..." >&2
    heal_invalid_flatlaf
    seed_flatlaf_request
    rm -f /tmp/.jd-agent.pid /tmp/.jd-laf-applied /tmp/.jd-laf-restart-request
    java -Djava.awt.headless=true -jar "${LAUNCHER}" < /dev/null >> /config/jd-flatlaf-bootstrap.log 2>&1 &
    htries=0
    while [ "${htries}" -lt 36 ]; do
        sleep 5
        htries=$((htries + 1))
        seed_flatlaf_request
        flatlaf_jar_valid "${JD_DIR}/libs/laf/flatlaf.jar" && break
    done
    if flatlaf_jar_valid "${JD_DIR}/libs/laf/flatlaf.jar"; then
        echo "[jdownloader-autostart] flatlaf.jar ready after headless bootstrap" >&2
    else
        echo "[jdownloader-autostart] flatlaf.jar still missing; the GUI will install it via the agent dialog" >&2
    fi
    pkill -TERM -f "JDownloader\.jar" 2>/dev/null || true
    w=0
    while pgrep -f "JDownloader\.jar" > /dev/null 2>&1 && [ "${w}" -lt 12 ]; do
        sleep 5
        w=$((w + 1))
    done
    pkill -KILL -f "JDownloader\.jar" 2>/dev/null || true
    rm -f /tmp/.jd-agent.pid /tmp/.jd-laf-applied /tmp/.jd-laf-restart-request
}

# Removes a corrupt flatlaf.jar and deregisters the extension so seeding re-arms and
# the updater fetches a fresh copy. Otherwise the broken jar passes every "is it
# installed" check and the GUI stays light.
heal_invalid_flatlaf() {
    jar="${JD_DIR}/libs/laf/flatlaf.jar"
    [ -f "${jar}" ] || return 0
    flatlaf_jar_valid "${jar}" && return 0
    echo "[jdownloader-autostart] INVALID flatlaf.jar detected (truncated install?), removing it and re-requesting the theme extension" >&2
    rm -f "${jar}"
    python3 - "${JD_DIR}/update/versioninfo/JD/extensions.installed.json" <<'PYEOF' >&2 || true
import json, os, sys
path = sys.argv[1]
if os.path.exists(path):
    try:
        ids = json.load(open(path))
        if isinstance(ids, list) and "flatlaf-themes" in ids:
            ids.remove("flatlaf-themes")
            json.dump(ids, open(path, "w"))
            print("[jdownloader-autostart] deregistered the broken flatlaf-themes install")
    except Exception:
        pass
PYEOF
}

# The classic counterpart. Only the core synthetica.jar is checked: skin and asset
# jars such as syntheticaJDCustom.jar carry no SyntheticaLookAndFeel.class, and
# deleting them as truncated breaks exposeSynthetica.
heal_invalid_synthetica() {
    [ "${EXPECT_CLASSIC}" = "1" ] || return 0
    jar="${JD_DIR}/libs/laf/synthetica.jar"
    [ -f "${jar}" ] || return 0
    synthetica_jar_valid "${jar}" && return 0
    echo "[jdownloader-autostart] INVALID synthetica.jar detected (truncated install?), removing" >&2
    rm -f "${jar}"
    if [ -f "${HELPERS}" ]; then
        python3 "${HELPERS}" deregister-synthetica \
            "${JD_DIR}/update/versioninfo/JD/extensions.installed.json" >&2 || true
    fi
    echo "[jdownloader-autostart] deregistered broken synthetica extension(s); re-requesting" >&2
    seed_synthetica_request
}

# JD ships cfg/synthetica-license.key inside JDownloader.jar, and SyntheticaHelper
# needs it there or at the same path under JD home. Without it the classic
# LookAndFeelType.DEFAULT throws and LookAndFeelController falls back to the system
# LAF, which on Linux is Metal. FlatLaf does not need the key, so it is only
# extracted for classic.
ensure_synthetica_license() {
    [ "${EXPECT_CLASSIC}" = "1" ] || return 0
    dest="${JD_DIR}/cfg/synthetica-license.key"
    rm -f /tmp/.jd-synthetica-license-missing
    if [ -s "${dest}" ]; then
        return 0
    fi
    [ -f "${LAUNCHER}" ] || {
        echo "[jdownloader-autostart] ERROR: classic JDDEFAULT needs synthetica-license.key but JDownloader.jar is missing" >&2
        : > /tmp/.jd-synthetica-license-missing
        return 1
    }
    mkdir -p "${JD_DIR}/cfg"
    python3 - "${dest}" "${LAUNCHER}" "${JD_DIR}/Core.jar" <<'PYEOF' >&2 || true
import os, sys, zipfile
dest = sys.argv[1]
entry = "cfg/synthetica-license.key"
for jar in sys.argv[2:]:
    if not os.path.isfile(jar):
        continue
    try:
        with zipfile.ZipFile(jar) as z:
            if entry not in z.namelist():
                continue
            data = z.read(entry)
        if not data or len(data) < 32:
            continue
        with open(dest, "wb") as out:
            out.write(data)
        print("[jdownloader-autostart] extracted synthetica-license.key from %s (%d bytes), required for classic JDDEFAULT" % (os.path.basename(jar), len(data)))
        sys.exit(0)
    except Exception as e:
        print("[jdownloader-autostart] license extract failed from %s: %s" % (os.path.basename(jar), e))
print("[jdownloader-autostart] ERROR: cfg/synthetica-license.key missing after extract; classic JDDEFAULT will fall back to Java Metal (marker: /tmp/.jd-synthetica-license-missing)")
sys.exit(1)
PYEOF
    if [ -s "${dest}" ]; then
        rm -f /tmp/.jd-synthetica-license-missing
        return 0
    fi
    : > /tmp/.jd-synthetica-license-missing
    return 1
}

# Download the bootstrap jar on the first start. Each attempt is checked as a zip,
# since a captive portal or DNS hijack returns an HTML page. If every attempt fails
# the error repeats in the log, rather than leaving an empty desktop with no hint.
if [ ! -f "${LAUNCHER}" ]; then
    echo "[jdownloader-autostart] Downloading JDownloader launcher to ${JD_DIR}" >&2
    mkdir -p "${JD_DIR}"
    dl_ok=0
    for attempt in 1 2 3; do
        if wget -q -O "${LAUNCHER}.tmp" "https://installer.jdownloader.org/JDownloader.jar" \
           && python3 -c "import sys,zipfile; zipfile.ZipFile(sys.argv[1]).namelist()" "${LAUNCHER}.tmp" 2>/dev/null; then
            mv "${LAUNCHER}.tmp" "${LAUNCHER}"
            dl_ok=1
            break
        fi
        rm -f "${LAUNCHER}.tmp"
        echo "[jdownloader-autostart] download attempt ${attempt}/3 failed (network/DNS/invalid file), retrying in 10s" >&2
        sleep 10
    done
    if [ "${dl_ok}" != "1" ]; then
        while true; do
            echo "  ###########################################################" >&2
            echo "   ERROR: could not download JDownloader.jar after 3 attempts." >&2
            echo "   Check the container's network/DNS, then RESTART the container." >&2
            echo "  ###########################################################" >&2
            sleep 60
        done
    fi
fi
ensure_synthetica_license
if [ "${EXPECT_CLASSIC}" = "1" ] && [ ! -s "${JD_DIR}/cfg/synthetica-license.key" ]; then
    echo "[jdownloader-autostart] ERROR: classic theme selected but synthetica license is missing, continuing boot (Dark/Light unaffected)" >&2
fi

# On a fresh install JD's whole updater chain runs once without a GUI first. With no
# GUI none of the forced dialogs can appear, so the core install (launcher, rescue
# updater, Core.jar and libs) finishes silently and the first GUI start takes seconds
# instead of minutes of a black WebUI behind hidden dialogs. The headless chain takes
# about 4 minutes, never prompts on stdin and does not install the FlatLaf themes
# extension, whose trigger needs the GUI; that design-install dialog still comes on
# the first GUI start, where the agent confirms it. The chain ends in a running
# headless daemon that has to stop before the GUI can take JD2's single-instance
# lock. JAVA_TOOL_OPTIONS is not exported yet, so this JVM runs without the agent.
#
# Only classic waits for its theme here. flatlaf.jar never arrives headless, while
# Synthetica can, so JDDEFAULT waits for both classic jars.
if [ ! -f "${JD_DIR}/Core.jar" ]; then
    echo "[jdownloader-autostart] fresh install: silent headless pre-install (no GUI = no dialogs; ~3-5 min)..." >&2
    if [ -n "${EXPECT_LAF}" ]; then
        echo "[jdownloader-autostart] JD_THEME=${JD_THEME:-Dark}: FlatLaf is installed on the first GUI start (not during headless)" >&2
    fi
    rm -f /tmp/.jd-agent.pid /tmp/.jd-laf-applied /tmp/.jd-laf-restart-request
    if [ -n "${EXPECT_LAF}" ]; then
        seed_flatlaf_request
    else
        seed_synthetica_request
    fi
    java -Djava.awt.headless=true -jar "${LAUNCHER}" < /dev/null >> /config/jd-headless-install.log 2>&1 &
    tries=0
    settle=0
    while [ "${tries}" -lt 90 ]; do
        sleep 10
        tries=$((tries + 1))
        theme_ok=0
        if [ "${EXPECT_CLASSIC}" = "1" ]; then
            classic_jars_ready && theme_ok=1
            seed_synthetica_request
        else
            theme_ok=1
        fi
        if [ -f "${JD_DIR}/Core.jar" ] && [ -f "${JD_DIR}/build.json" ] && [ "${theme_ok}" = "1" ]; then
            settle=$((settle + 1))
        else
            settle=0
        fi
        [ "${settle}" -ge 3 ] && break
    done
    if [ "${settle}" -ge 3 ]; then
        echo "[jdownloader-autostart] headless pre-install complete, stopping the headless daemon and starting the GUI" >&2
    else
        echo "[jdownloader-autostart] headless pre-install did not settle within 15 min, falling back to the GUI installer" >&2
    fi
    # TERM, wait, then KILL what is left. "JDownloader\.jar" matches every stage
    # (launcher, JDU relaunch, Core run) but not the Python helpers or the
    # -javaagent path, which lack the .jar suffix.
    pkill -TERM -f "JDownloader\.jar" 2>/dev/null || true
    w=0
    while pgrep -f "JDownloader\.jar" > /dev/null 2>&1 && [ "${w}" -lt 12 ]; do
        sleep 5
        w=$((w + 1))
    done
    pkill -KILL -f "JDownloader\.jar" 2>/dev/null || true
    rm -f /tmp/.jd-agent.pid /tmp/.jd-laf-applied /tmp/.jd-laf-restart-request
    # Headless JD can recreate update/versioninfo and drop the request, so seed again.
    if [ -n "${EXPECT_LAF}" ]; then
        seed_flatlaf_request
    elif [ "${EXPECT_CLASSIC}" = "1" ]; then
        seed_synthetica_request
    fi
fi

echo "" >&2
echo "  ============================================================" >&2
echo "   JDownloader is starting." >&2
echo "   The FIRST start installs JDownloader and the selected theme" >&2
echo "   (Dark / Light / JDDEFAULT) and can take a few minutes." >&2
echo "   Dark and Light finish FlatLaf on the first GUI start." >&2
echo "   Do NOT restart the container. Wait for the READY banner below." >&2
echo "  ============================================================" >&2
echo "" >&2

# The READY marker must be cleared on every boot: /tmp survives docker stop/start,
# and a leftover marker would make the watcher below exit at once, so the READY
# banner would only fire on the first boot. The agent's markers go too, so a stale
# .jd-laf-applied cannot vouch for this run.
rm -f /tmp/.jd-ready /tmp/.jd-agent.pid /tmp/.jd-laf-applied /tmp/.jd-laf-restart-request /tmp/.jd-classic-bootstrap-tried /tmp/.jd-flatlaf-bootstrap-tried

# The agent inside JD's JVM writes /tmp/.jd-agent.pid (its JVM pid) and
# /tmp/.jd-laf-applied (the class name of the look and feel actually applied). The
# subshells below inherit these helpers.
agent_alive() {
    p=$(cat /tmp/.jd-agent.pid 2>/dev/null)
    [ -n "${p}" ] && kill -0 "${p}" 2>/dev/null
}
laf_matches() {
    [ -f /tmp/.jd-laf-applied ] || return 1
    # Classic counts only Synthetica or JDDefault; Metal is the failed fallback.
    if [ "${EXPECT_CLASSIC}" = "1" ]; then
        if grep -qiE 'synthetica|jddefault' /tmp/.jd-laf-applied 2>/dev/null; then
            return 0
        fi
        return 1
    fi
    # An empty pattern would match Metal too.
    [ -n "${EXPECT_LAF}" ] || return 1
    grep -qi "${EXPECT_LAF}" /tmp/.jd-laf-applied 2>/dev/null
}
# Restarts JD politely. TERM to the agent's pid lets the shutdown hooks save the
# settings; pgrep is the fallback when the agent is not running.
heal_restart() {
    p=$(cat /tmp/.jd-agent.pid 2>/dev/null)
    if [ -n "${p}" ] && kill -0 "${p}" 2>/dev/null; then
        kill -TERM "${p}" 2>/dev/null || true
    else
        pkill -TERM -f "JDownloader\.jar" 2>/dev/null || true
    fi
}

# Announces in the log when JD is up. The watcher keeps running and prints a fresh
# banner after every restart (self-update relaunch, heal, crash), since without one a
# healthy restarted JD looks stuck.
(
    # READY needs the agent's word that the expected look and feel is applied. A
    # pending "restart to apply" dialog can leave the GUI white while the API port is
    # up, and flatlaf.jar is stock, so nothing on disk tells the two apart. Without a
    # live agent the fallback banner below says the theme is unverified.
    up_and_themed() {
        agent_alive && laf_matches
    }
    stable=0
    waited=0
    last_banner_pid=""
    while true; do
        if up_and_themed; then stable=$((stable + 1)); else stable=0; fi
        waited=$((waited + 1))
        cur_pid=$(cat /tmp/.jd-agent.pid 2>/dev/null)
        if [ "${stable}" -ge 4 ] && [ -n "${cur_pid}" ] && [ "${cur_pid}" != "${last_banner_pid}" ]; then
            : > /tmp/.jd-ready
            last_banner_pid="${cur_pid}"
            waited=0
            # The ASCII banner goes right above the READY status, so brand and
            # status are the last block in the log.
            case "${JD_THEME:-Dark}" in
                JDDEFAULT|jddefault|*[Dd][Ee][Ff][Aa][Uu][Ll][Tt]*) _sub="Default UI · Selkies · Java 21" ;;
                Light|JD_Plain|*[Ll][Ii][Gg][Hh][Tt]*) _sub="Light UI · Selkies · Java 21" ;;
                Dark|JD_Plain_Dark|*[Dd][Aa][Rr][Kk]*) _sub="Modern dark UI · Selkies · Java 21" ;;
                *) _sub="Modern UI · Selkies · Java 21" ;;
            esac
            /usr/local/bin/print-banner.sh \
                "JDownloader for Unraid" \
                "${_sub}" \
                >&2 2>/dev/null || true
            # Plain ANSI SGR codes rather than tput, since a minimal container has no
            # terminfo. docker logs passes them through, so Unraid's log panel shows
            # the colour and other viewers show inert codes. printf, because echo -e
            # is not portable under /bin/sh.
            printf '  \033[0;32m✓ JDOWNLOADER IS READY\033[0m - Open the WebUI via HTTPS on port 3001\n' >&2
            echo "" >&2
        elif [ ! -f /tmp/.jd-ready ] && [ "${waited}" -ge 120 ]; then
            # After about 10 minutes on the first boot JD is usable, but the theme is
            # unverified, so the log says that instead of READY.
            : > /tmp/.jd-ready
            echo "" >&2
            printf '  \033[0;33m! JDOWNLOADER IS UP (theme NOT verified)\033[0m - Open the WebUI via HTTPS on port 3001\n' >&2
            echo "    If the UI looks wrong, check the log above for [jd-dialog-agent]" >&2
            echo "    lines and restart the container once." >&2
            if [ -n "${EXPECT_LAF}" ] && [ ! -f "${JD_DIR}/libs/laf/flatlaf.jar" ]; then
                echo "    NOTE: the FlatLaf theme was requested but JD never installed it." >&2
                echo "    The design download may have failed (blocked/slow network)." >&2
                echo "    Check connectivity, then restart the container." >&2
            fi
            echo "" >&2
        fi
        sleep 5
    done
) &

# Theme healer. When JD runs with a look and feel other than the expected one (a
# pending apply, a wedged dialog, a reset after a self-update), one polite restart
# applies the one recorded in JD's config. It also serves the dialog agent's restart
# request for a LAF dialog with unknown button labels. At most 3 heals per hour, so it
# still heals after a week of uptime but cannot turn into a restart loop.
(
    port_up() {
        python3 -c "import socket,sys; s=socket.socket(); s.settimeout(1); sys.exit(0 if s.connect_ex(('127.0.0.1',9666))==0 else 1)" 2>/dev/null
    }
    # Wait until JD is up and stable (API port or agent alive), so the healer does
    # not act while the install flaps.
    s=0
    while [ "${s}" -lt 3 ]; do
        if port_up || agent_alive; then s=$((s + 1)); else s=0; fi
        sleep 5
    done
    window_start=$(date +%s)
    heals=0
    mismatch=0
    last_pid=""
    pid_age=0
    while true; do
        sleep 8
        now=$(date +%s)
        if [ $((now - window_start)) -ge 3600 ]; then
            window_start=${now}
            heals=0
        fi
        # /tmp/.jd-ready lasts the whole container lifetime, so it only protects the
        # first start. Every later JVM also starts on the JVM-default Metal LAF, which
        # on a slow box outlasts the mismatch threshold and would get a healthy JD
        # restarted until the budget is gone. Each new agent pid gets about 2 minutes
        # before mismatches count.
        cur_pid=$(cat /tmp/.jd-agent.pid 2>/dev/null)
        if [ "${cur_pid}" != "${last_pid}" ]; then
            last_pid="${cur_pid}"
            pid_age=0
            mismatch=0
        else
            pid_age=$((pid_age + 1))
        fi
        [ "${heals}" -ge 3 ] && continue
        # Explicit restart request from the dialog agent (LAF dialog, unknown buttons).
        if [ -f /tmp/.jd-laf-restart-request ]; then
            rm -f /tmp/.jd-laf-restart-request
            heals=$((heals + 1)); mismatch=0
            echo "[jdownloader-autostart] dialog agent requested a JD restart (pending look-and-feel), restarting (${heals}/3 this hour)" >&2
            heal_restart
            sleep 25
            continue
        fi
        # The agent reports a different LAF than expected. A restart only helps once
        # FlatLaf has a valid flatlaf.jar, or classic a valid Synthetica and licence;
        # while the first jar download is pending it would just keep JD on Metal.
        if [ "${pid_age}" -ge 15 ] && [ -f /tmp/.jd-ready ] && agent_alive && ! laf_matches; then
            if [ -n "${EXPECT_LAF}" ]; then
                if flatlaf_jar_valid "${JD_DIR}/libs/laf/flatlaf.jar"; then
                    mismatch=$((mismatch + 1))
                else
                    seed_flatlaf_request
                    if [ "${_flatlaf_wait_logged:-}" != "${cur_pid}" ]; then
                        _flatlaf_wait_logged="${cur_pid}"
                        echo "[jdownloader-autostart] FlatLaf theme selected but flatlaf.jar not ready yet, waiting (not healing, to avoid a Metal restart loop)" >&2
                    fi
                    mismatch=0
                fi
            elif [ "${EXPECT_CLASSIC}" = "1" ]; then
                syn_ok=0
                lic_ok=0
                # Healing needs core and JDCustom; core alone still gives Metal.
                classic_jars_ready && syn_ok=1
                [ -s "${JD_DIR}/cfg/synthetica-license.key" ] && lic_ok=1
                if [ -f "${HELPERS}" ]; then
                    if python3 "${HELPERS}" should-heal-classic \
                            --classic 1 --matches 0 --synthetica "${syn_ok}" \
                            --license "${lic_ok}"; then
                        mismatch=$((mismatch + 1))
                    else
                        if [ "${syn_ok}" != "1" ] || [ "${lic_ok}" != "1" ]; then
                            if [ "${_classic_wait_logged:-}" != "${cur_pid}" ]; then
                                _classic_wait_logged="${cur_pid}"
                                echo "[jdownloader-autostart] classic LAF not ready yet (waiting for synthetica.jar + syntheticaJDCustom.jar and/or license); not healing" >&2
                            fi
                            # Seeding while waiting also recovers a deleted JDCustom.
                            seed_synthetica_request
                        fi
                        mismatch=0
                    fi
                elif [ "${syn_ok}" = "1" ] && [ "${lic_ok}" = "1" ]; then
                    # Without the helpers, the same gate as should-heal-classic.
                    mismatch=$((mismatch + 1))
                else
                    seed_synthetica_request
                    mismatch=0
                fi
            else
                mismatch=0
            fi
        else
            mismatch=0
        fi
        if [ "${mismatch}" -ge 4 ]; then
            heals=$((heals + 1)); mismatch=0
            echo "[jdownloader-autostart] applied LAF differs from expected (JD_THEME=${JD_THEME:-Dark}), restarting JD to apply (${heals}/3 this hour)" >&2
            heal_restart
            sleep 25
        fi
    done
) &

echo "[jdownloader-autostart] Starting JDownloader (first start may take a few minutes)" >&2

bootstrap_classic_jars_if_needed
bootstrap_flatlaf_if_needed

fast_exits=0
while true; do
    # The flat icon pack is for FlatLaf only; classic JDDEFAULT keeps JD's stock
    # icons. EXPECT_CLASSIC is already normalised, where comparing the raw JD_THEME
    # would trip over casing and whitespace.
    if [ "${EXPECT_CLASSIC}" = "1" ]; then
            ensure_synthetica_license
            heal_invalid_synthetica
            seed_synthetica_request
            seed_flatlaf_request
            # Park flatlaf.jar so JD cannot keep applying FlatLaf Light/Dark over classic.
            if [ -f "${JD_DIR}/libs/laf/flatlaf.jar" ]; then
                mv -f "${JD_DIR}/libs/laf/flatlaf.jar" "${JD_DIR}/libs/laf/flatlaf.jar.disabled-for-classic" 2>/dev/null || true
                echo "[jdownloader-autostart] disabled flatlaf.jar (JD_THEME=JDDEFAULT wants classic DEFAULT LAF)" >&2
            fi
            echo "[jdownloader-autostart] libs/laf for classic:" >&2
            ls -la "${JD_DIR}/libs/laf" 2>/dev/null | head -40 >&2 || echo "  (libs/laf missing)" >&2
    else
            # Restore the jar a classic run parked.
            if [ -f "${JD_DIR}/libs/laf/flatlaf.jar.disabled-for-classic" ] && [ ! -f "${JD_DIR}/libs/laf/flatlaf.jar" ]; then
                mv -f "${JD_DIR}/libs/laf/flatlaf.jar.disabled-for-classic" "${JD_DIR}/libs/laf/flatlaf.jar" 2>/dev/null || true
                echo "[jdownloader-autostart] re-enabled flatlaf.jar for FlatLaf theme" >&2
            fi
            # JD resets /config/.../themes during its first install, wiping the icons
            # cont-init seeded, so they are copied again before each start to keep
            # iconsetid=flat resolving.
            #
            # FlatLaf itself is not seeded into libs/laf. JD installs and registers the
            # FLATLAF_DARK design on its own (the agent confirms the dialog); with a
            # pre-seeded jar it never registered the design and asked on every start.
            # The dark chrome is JD's own FlatDarkLaf plus the defaults the agent
            # registers from /opt/JDownloader/flatlaf-defaults through FlatLaf's
            # registerCustomDefaultsSource API, so flatlaf.jar stays stock and a
            # self-update cannot reset it. The dark content is JD's colorfor* config
            # (jdownloader-theme.sh).
            mkdir -p "${JD_DIR}/themes"
            cp -rf /opt/JDownloader/themes-default/. "${JD_DIR}/themes/" 2>/dev/null || true
    fi

    # The theme is applied after the FlatLaf heal and seed. A fresh JDDEFAULT install
    # has no flatlaf.jar, and writing FLATLAF_* for Light or Dark without it makes
    # LookAndFeelController fall back to Metal. So while Synthetica is on disk, classic
    # DEFAULT is held until FlatLaf is valid, and the healer then restarts into it.
    THEME_APPLY="${JD_THEME:-Dark}"
    if [ -n "${EXPECT_LAF}" ]; then
        heal_invalid_flatlaf
        seed_flatlaf_request
        if ! flatlaf_jar_valid "${JD_DIR}/libs/laf/flatlaf.jar"; then
            if any_synthetica_valid; then
                THEME_APPLY="JDDEFAULT"
                echo "[jdownloader-autostart] JD_THEME=${JD_THEME:-Dark} but flatlaf.jar missing, holding classic DEFAULT until FlatLaf installs (avoids Metal)" >&2
            else
                echo "[jdownloader-autostart] JD_THEME=${JD_THEME:-Dark}: writing FlatLaf into cfg so the GUI install dialog can run (agent auto-confirms; Metal until flatlaf.jar lands)" >&2
            fi
        fi
    fi
    # JD's self-update can reset cfg/laf/*.json, and cont-init alone would lose that
    # race on some boots.
    /usr/local/bin/jdownloader-theme.sh "${THEME_APPLY}" >/dev/null 2>&1 || true

    # The tray extension's startup probe raises the "tray isn't supported" popup;
    # with its jar renamed, JD's extension loader skips it.
    python3 /usr/local/bin/kill-tray-extension.py "${JD_DIR}" 2>/dev/null || true

    # The tray cfg is locked read-only so JD's bootstrap installer cannot write
    # enabled=true back during first-run setup.
    python3 /usr/local/bin/disable-tray.py "${JD_DIR}/cfg" 2>/dev/null || true
    chmod 444 \
        "${JD_DIR}/cfg/org.jdownloader.gui.jdtrayicon.TrayExtension.json" \
        "${JD_DIR}/cfg/org.jdownloader.gui.jdtrayicon.TrayExtensionConfig.json" \
        2>/dev/null || true

    # Turns off JD's advertising (the "Become premium user" banner, premium-alert
    # columns, special-deal popups), which also gives the download graph its full
    # height. JD resets this cfg on install and update.
    python3 /usr/local/bin/jdownloader-noads.py "${JD_DIR}/cfg" 2>/dev/null || true

    # JD_SELFUPDATE=false turns off JD's periodic self-update checks. It is opt-in
    # because the same channel delivers the hoster plugins, which go stale within
    # weeks, and the first install needs the updater. So libs/ has to exist and the
    # theme jars this JD_THEME needs have to be in place (FlatLaf for Dark and Light,
    # valid Synthetica jars and the licence for classic); freezing earlier would leave
    # JD on Metal with no way to heal.
    if [ "${JD_SELFUPDATE:-true}" = "false" ] && [ -d "${JD_DIR}/libs" ]; then
        _freeze_ok=0
        if [ "${EXPECT_CLASSIC}" = "1" ]; then
            if classic_jars_ready && [ -s "${JD_DIR}/cfg/synthetica-license.key" ]; then
                _freeze_ok=1
            fi
        elif [ -n "${EXPECT_LAF}" ] && flatlaf_jar_valid "${JD_DIR}/libs/laf/flatlaf.jar"; then
            _freeze_ok=1
        fi
        if [ "${_freeze_ok}" = "1" ]; then
        python3 - "${JD_DIR}/cfg/org.jdownloader.updatev2.UpdateSettings.json" <<'PYEOF' >&2 || true
import json, os, sys
path = sys.argv[1]
d = {}
if os.path.exists(path):
    try:
        d = json.load(open(path))
    except Exception:
        pass
d["autoupdatecheckenabled"] = False
d["installupdatesonexitenabled"] = False
os.makedirs(os.path.dirname(path), exist_ok=True)
json.dump(d, open(path, "w"), indent=2)
print("[jdownloader-autostart] JD_SELFUPDATE=false -> periodic self-update checks disabled")
PYEOF
        fi
        unset _freeze_ok
    fi

    # Logs the JD core build of each launch, so drift after a self-update shows in
    # the container log.
    if [ -f "${JD_DIR}/build.json" ]; then
        rev=$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(', '.join(str(k)+'='+str(v) for k,v in sorted(d.items())[:4]))" "${JD_DIR}/build.json" 2>/dev/null)
        echo "[jdownloader-autostart] JD build: ${rev:-unknown}" >&2
    fi

    # FlatLaf stays off the boot classpath: a jar there has a null classloader, and
    # FlatLaf's lazy UI-delegate loading then throws an NPE at FlatLaf.java:817 and
    # crashes the GUI in a loop.
    #
    # The dialog agent clicks through JD's forced first-run and update installer
    # dialogs (UpdateController shows them whenever the GUI is visible, and no config
    # suppresses them). JD's relaunched child JVM, where the GUI lives, inherits
    # JAVA_TOOL_OPTIONS.
    export JAVA_TOOL_OPTIONS="-javaagent:/opt/JDownloader/jd-dialog-agent.jar"

    # A crash-looping JD must not inherit the previous JVM's markers, or READY would
    # report a look and feel this launch never applied.
    rm -f /tmp/.jd-agent.pid /tmp/.jd-laf-applied /tmp/.jd-laf-restart-request

    launch_ts=$(date +%s)
    echo "[jdownloader-autostart] launching JDownloader JVM (the GUI starts here)..." >&2
    # -Dsun.awt.disablegrab=true keeps the File, Settings and Extras menus from closing
    # on mouse release under the streamed X desktop (Swing's popup X grab).
    # shellcheck disable=SC2086  # JD_UI_SCALE_OPT is a single optional -D flag (empty = omit it)
    java \
        -Dawt.useSystemAAFontSettings=on \
        -Dswing.aatext=true \
        -Dsun.java2d.opengl=false \
        -Dsun.awt.disablemixing=true \
        -Dsun.awt.disablegrab=true \
        ${JD_UI_SCALE_OPT} \
        -jar "${LAUNCHER}"
    EXIT=$?

    # Unlock the tray cfg so the next disable-tray.py can update it; the top of the
    # loop locks it again.
    chmod 644 \
        "${JD_DIR}/cfg/org.jdownloader.gui.jdtrayicon.TrayExtension.json" \
        "${JD_DIR}/cfg/org.jdownloader.gui.jdtrayicon.TrayExtensionConfig.json" \
        2>/dev/null || true

    # Remove the tray extension jar if JD downloaded it during this run.
    python3 /usr/local/bin/kill-tray-extension.py "${JD_DIR}" 2>/dev/null || true

    run_dur=$(( $(date +%s) - launch_ts ))
    echo "[jdownloader-autostart] JDownloader exited (code ${EXIT}) after ${run_dur}s" >&2

    # Give a self-updated JD (SmartRlyExitRequest) a moment to spawn.
    sleep 5

    # A second JD on the same /config corrupts locks and the database, so wait while
    # one runs. The relaunched JVM's agent writes its pid at premain; the grace window
    # covers a parent that exits before the child has written it, and pgrep is the
    # fallback without an agent. The pattern is "JDownloader\.jar" because a bare
    # "JDownloader" also matches the Python tray helpers and the -javaagent path and
    # would park this loop on a process that is not JD.
    parked=0
    g=0
    while [ "${g}" -lt 6 ]; do
        p=$(cat /tmp/.jd-agent.pid 2>/dev/null)
        if [ -n "${p}" ] && kill -0 "${p}" 2>/dev/null; then
            echo "[jdownloader-autostart] self-relaunched JD (pid ${p}) is running, waiting for it to stop..." >&2
            while [ -n "${p}" ] && kill -0 "${p}" 2>/dev/null; do
                sleep 10
                p2=$(cat /tmp/.jd-agent.pid 2>/dev/null)
                [ -n "${p2}" ] && p="${p2}"   # follow further self-updates
            done
            parked=1
            break
        fi
        if pgrep -f "JDownloader\.jar" > /dev/null 2>&1; then
            echo "[jdownloader-autostart] another JD instance running (pgrep fallback), waiting for it to stop..." >&2
            while pgrep -f "JDownloader\.jar" > /dev/null 2>&1; do
                sleep 10
            done
            parked=1
            break
        fi
        g=$((g + 1))
        sleep 3
    done
    [ "${parked}" = "1" ] && echo "[jdownloader-autostart] JD stopped, resuming restart loop" >&2

    # Repeated fast exits (under 60 s, no relaunch) mean something is wrong, so back
    # off by 30 s per exit, up to 5 minutes, instead of crash-looping every 5 seconds.
    if [ "${parked}" = "1" ] || [ "${run_dur}" -ge 60 ]; then
        fast_exits=0
    else
        fast_exits=$((fast_exits + 1))
    fi
    if [ "${fast_exits}" -ge 3 ]; then
        delay=$((30 * fast_exits))
        [ "${delay}" -gt 300 ] && delay=300
        echo "[jdownloader-autostart] JD exiting fast repeatedly (${fast_exits}x <60s), backing off ${delay}s" >&2
        sleep "${delay}"
    fi

    echo "[jdownloader-autostart] Restarting JDownloader..." >&2
done
