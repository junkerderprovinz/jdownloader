#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# JDownloader 2 autostart für linuxserver/baseimage-kasmvnc
# -----------------------------------------------------------------------------

# Locale-Fallback
export LANG="${LANG:-de_DE.UTF-8}"
export LANGUAGE="${LANGUAGE:-de_DE:de:en}"
export LC_ALL="${LC_ALL:-de_DE.UTF-8}"

# Java-Flags für besseres Font-Rendering und Swing-Performance
export JAVA_TOOL_OPTIONS="${JAVA_TOOL_OPTIONS:-\
-Dawt.useSystemAAFontSettings=on \
-Dswing.aatext=true \
-Dsun.java2d.opengl=false}"

JD_DIR="${JD_INST_DIR:-/config/JDownloader}"

echo "[jdownloader-autostart] Starting JDownloader from ${JD_DIR}" >&2

# Warten bis das Installation-Verzeichnis bereit ist (init-jdownloader läuft parallel)
for i in $(seq 1 30); do
    [[ -f "${JD_DIR}/JDownloader2.jar" ]] && break
    echo "[jdownloader-autostart] Waiting for JDownloader install... (${i}/30)" >&2
    sleep 2
done

if [[ ! -f "${JD_DIR}/JDownloader2.jar" ]]; then
    echo "[jdownloader-autostart] ERROR: JDownloader2.jar not found in ${JD_DIR}" >&2
    exit 1
fi

exec java \
    -Dawt.useSystemAAFontSettings=on \
    -Dswing.aatext=true \
    -Dsun.java2d.opengl=false \
    -jar "${JD_DIR}/JDownloader2.jar"
