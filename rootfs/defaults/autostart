#!/bin/sh
# NOTE: openbox executes this with /bin/sh — no [[ bash syntax allowed.
# JDownloader launcher loop:
#   - First start: JDownloader.jar bootstraps and installs JD2 (needs a live DISPLAY).
#   - SmartRlyExitRequest (self-update): launcher exits, loop restarts it automatically.
#   - Normal exits / crashes: loop restarts within 5 seconds.

export LANG="${LANG:-de_DE.UTF-8}"
export LANGUAGE="${LANGUAGE:-de_DE:de:en}"
export LC_ALL="${LC_ALL:-de_DE.UTF-8}"

# Set X11 root window (desktop background) to Breeze Dark so the
# area outside JD's window is dark instead of the default grey/white.
xsetroot -solid '#232629' 2>/dev/null || true

# Provide a minimal system tray so java.awt.SystemTray.isSupported() is TRUE.
# JD's SystemTrayExtension is bundled in Core.jar and probes isSupported() on
# every start regardless of config; with no tray it shows the "system tray isn't
# supported" popup. stalonetray owns the _NET_SYSTEM_TRAY selection so the probe
# passes and the popup never appears. 1x1 in the top-left corner, hidden behind
# the maximised JD window — effectively invisible.
if command -v stalonetray >/dev/null 2>&1 && ! pgrep -x stalonetray >/dev/null 2>&1; then
    stalonetray --geometry 1x1+0+0 --icon-size 1 --background '#232629' \
        >/dev/null 2>&1 &
fi

JD_DIR="${JD_INST_DIR:-/config/JDownloader}"
LAUNCHER="${JD_DIR}/JDownloader.jar"

# Download bootstrap JAR if not yet present in config volume
if [ ! -f "${LAUNCHER}" ]; then
    echo "[jdownloader-autostart] Downloading JDownloader launcher to ${JD_DIR}" >&2
    mkdir -p "${JD_DIR}"
    wget -q -O "${LAUNCHER}.tmp" "https://installer.jdownloader.org/JDownloader.jar" \
        && mv "${LAUNCHER}.tmp" "${LAUNCHER}" \
        || { echo "[jdownloader-autostart] ERROR: download failed" >&2; rm -f "${LAUNCHER}.tmp"; exit 1; }
fi

echo "[jdownloader-autostart] Starting JDownloader (first start may take up to 5 minutes)" >&2

while true; do
    # Pre-start: seed Breeze-Dark-patched FlatLaf (confirm=true → no install dialog).
    python3 /usr/local/bin/seed-flatlaf.py \
        /opt/JDownloader/flatlaf.jar \
        "${JD_DIR}/libs/laf" 2>/dev/null || true
    # Lock FlatLaf JAR + dep.json so JD's AWU cannot replace them during install.
    chmod 444 \
        "${JD_DIR}/libs/laf/flatlaf.jar" \
        "${JD_DIR}/libs/laf/flatlaf.dep.json" \
        2>/dev/null || true

    # Remove SystemTrayExtension JAR if JD's bootstrap installed it. The popup
    # 'tray isn't supported' is triggered by the extension's startup probe; if
    # the JAR is renamed, JD's extension loader skips it and the probe never runs.
    python3 /usr/local/bin/kill-tray-extension.py "${JD_DIR}" 2>/dev/null || true

    # Disable system tray and lock the cfg files read-only so JD's bootstrap
    # installer cannot overwrite them with enabled=true during first-run setup.
    python3 /usr/local/bin/disable-tray.py "${JD_DIR}/cfg" 2>/dev/null || true
    chmod 444 \
        "${JD_DIR}/cfg/org.jdownloader.gui.jdtrayicon.TrayExtension.json" \
        "${JD_DIR}/cfg/org.jdownloader.gui.jdtrayicon.TrayExtensionConfig.json" \
        2>/dev/null || true

    # Put FlatLaf on the JVM boot classpath so it is available before JD creates
    # any Swing components — fixes the half-light/half-dark rendering issue caused
    # by FlatLaf loading too late in JD's dynamic class-loading sequence.
    #
    # IMPORTANT: load FlatLaf from the IMMUTABLE image copy (/opt), NOT the
    # AWU-managed libs/laf copy. On a fresh /config, JD's auto-updater DELETES
    # libs/laf/flatlaf.jar during the first install — which leaves FLATLAF_DARK
    # unable to load and the whole UI falls back to light. /opt/JDownloader/flatlaf.jar
    # is baked into the image, read-only and always present, so FlatDarkLaf loads
    # from the very first launch. JAVA_TOOL_OPTIONS is inherited by JD's relaunched
    # child JVM, so the actual app JVM gets it too.
    LAF_JAR="/opt/JDownloader/flatlaf.jar"
    if [ -f "${LAF_JAR}" ]; then
        export JAVA_TOOL_OPTIONS="-Xbootclasspath/a:${LAF_JAR} -Dswing.defaultlaf=com.formdev.flatlaf.FlatDarkLaf"
    else
        unset JAVA_TOOL_OPTIONS
    fi

    # Title bar / maximise is handled by an openbox <application> rule (see
    # 10-jdownloader-setup) — openbox only honours decorations at map time, so a
    # runtime _MOTIF_WM_HINTS change via xprop did not work.
    #
    # -Dsun.awt.disablegrab=true fixes the File/Settings/Extras menus closing on
    # mouse-release under KasmVNC (Swing's popup X grab). It only works with the
    # old title-bar poller gone — that poller kept stealing focus and re-closing
    # the menus, which previously masked this fix.
    java \
        -Dawt.useSystemAAFontSettings=on \
        -Dswing.aatext=true \
        -Dsun.java2d.opengl=false \
        -Dsun.awt.disablemixing=true \
        -Dsun.awt.disablegrab=true \
        -jar "${LAUNCHER}"
    EXIT=$?

    # Unlock cfg files so the next iteration's disable-tray.py / seed-flatlaf.py
    # can update them. Re-locks happen at the top of the next loop iteration.
    chmod 644 \
        "${JD_DIR}/cfg/org.jdownloader.gui.jdtrayicon.TrayExtension.json" \
        "${JD_DIR}/cfg/org.jdownloader.gui.jdtrayicon.TrayExtensionConfig.json" \
        "${JD_DIR}/libs/laf/flatlaf.jar" \
        "${JD_DIR}/libs/laf/flatlaf.dep.json" \
        2>/dev/null || true

    # Remove the tray extension JAR if JD downloaded it during this iteration.
    # The next iteration's pre-start kill will be a no-op then.
    python3 /usr/local/bin/kill-tray-extension.py "${JD_DIR}" 2>/dev/null || true

    echo "[jdownloader-autostart] JDownloader exited (code ${EXIT})" >&2

    # Re-seed after exit — catches the case where JD's bootstrap downloaded and
    # replaced libs/laf/flatlaf.jar with the upstream (unpatched) version.
    python3 /usr/local/bin/seed-flatlaf.py \
        /opt/JDownloader/flatlaf.jar \
        "${JD_DIR}/libs/laf" 2>/dev/null || true

    # Wait briefly — JD may have spawned a self-updated process (SmartRlyExitRequest)
    sleep 5

    # Do not start a second bootstrap while a JD instance is already running.
    if pgrep -f "JDownloader" > /dev/null 2>&1; then
        echo "[jdownloader-autostart] Another JD instance running — waiting for it to stop..." >&2
        while pgrep -f "JDownloader" > /dev/null 2>&1; do
            sleep 10
        done
        echo "[jdownloader-autostart] JD stopped, resuming restart loop" >&2
    fi

    echo "[jdownloader-autostart] Restarting JDownloader..." >&2
done
