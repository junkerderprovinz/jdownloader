#!/bin/sh
# NOTE: openbox executes this with /bin/sh — no [[ bash syntax allowed.
# JDownloader launcher loop:
#   - First start: JDownloader.jar bootstraps and installs JD2 (needs a live DISPLAY).
#   - SmartRlyExitRequest (self-update): launcher exits, loop restarts it automatically.
#   - Normal exits / crashes: loop restarts within 5 seconds.

export LANG="${LANG:-en_US.UTF-8}"
export LANGUAGE="${LANGUAGE:-en_US:en}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

# Browser wiring for JD's link/captcha opener. cont-init writes BROWSER +
# XDG_CURRENT_DESKTOP into the s6 container-environment, but svc-de (which launches
# this JVM) has no s6-rc dependency on that cont-init oneshot, so on some boots the
# session starts before the write and JD comes up with no browser handler (AppWork
# "Unsupported OpenBrowser"). Re-derive them HERE, in the JVM's direct parent, so they
# are always inherited. JD_ENABLE_BROWSER is captured at container start (always
# present); the /config sentinel covers a recreate that dropped the variable.
case "${JD_ENABLE_BROWSER:-}" in
    [Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|1|[Oo][Nn]) _jd_browser=1 ;;
    *) [ -f /config/.jd-browser-enabled ] && _jd_browser=1 || _jd_browser=0 ;;
esac
if [ "${_jd_browser}" = "1" ]; then
    export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-XFCE}"
    export BROWSER="${BROWSER:-/usr/local/bin/ff-launch}"
fi

# Optional HiDPI UI scaling. On a Selkies web desktop the whole X display is streamed
# as one H.264 video and the browser scales that stream, so zooming the browser to read
# a high-resolution desktop upscales the video and blurs the text. JD_UI_SCALE instead
# tells Swing to render the WHOLE JDownloader UI larger at full pixel density, so text
# stays crisp at the desktop's native resolution with the browser at 100%. Empty/unset
# keeps JD's native 1x. Example values: 1.25, 1.5, 2.
JD_UI_SCALE_OPT=""
case "${JD_UI_SCALE:-}" in
    "") : ;;
    *[!0-9.]*) echo "[jdownloader-autostart] ignoring invalid JD_UI_SCALE='${JD_UI_SCALE}' (use a number like 1.5)" >&2 ;;
    *) JD_UI_SCALE_OPT="-Dsun.java2d.uiScale=${JD_UI_SCALE}"
       echo "[jdownloader-autostart] JD_UI_SCALE=${JD_UI_SCALE} -> HiDPI Swing scaling enabled (crisp text without browser zoom)" >&2 ;;
esac

# Set X11 root window (desktop background) to the theme's #161616 base so
# the area outside JD's window is dark instead of the default grey/white.
xsetroot -solid '#161616' 2>/dev/null || true

# (JD's "system tray isn't supported" popup — raised by the SystemTrayExtension in
# Core.jar — is auto-dismissed by the dialog agent; see JAVA_TOOL_OPTIONS below.)

JD_DIR="${JD_INST_DIR:-/config/JDownloader}"
LAUNCHER="${JD_DIR}/JDownloader.jar"

# Expected LAF class fragment, mirroring jdownloader-theme.sh's JD_THEME mapping.
# Empty expect_laf = classic JDDEFAULT. Canonical value is JDDEFAULT; any casing
# must resolve the same (helpers) — lowercase-only classic paths previously
# split-brain with this literal case arm and left Metal.
HELPERS="/usr/local/bin/jdownloader-laf-helpers.py"
EXPECT_LAF="flatdark"
EXPECT_CLASSIC=0
if [ -f "${HELPERS}" ]; then
    _resolved=$(python3 "${HELPERS}" resolve "${JD_THEME:-Dark}")
    EXPECT_LAF=$(printf '%s\n' "${_resolved}" | awk -F= '/^expect_laf=/{print $2; exit}')
    EXPECT_CLASSIC=$(printf '%s\n' "${_resolved}" | awk -F= '/^expect_classic=/{print $2; exit}')
    unset _resolved
else
    THEME_LC=$(printf '%s' "${JD_THEME:-Dark}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | tr '[:upper:]' '[:lower:]')
    case "${THEME_LC}" in
        jddefault) EXPECT_LAF=""; EXPECT_CLASSIC=1 ;;
        light|jd_plain) EXPECT_LAF="flatlight"; EXPECT_CLASSIC=0 ;;
        *dark*) EXPECT_LAF="flatdark"; EXPECT_CLASSIC=0 ;;
        *) EXPECT_LAF="flatdark"; EXPECT_CLASSIC=0 ;;
    esac
fi
: "${EXPECT_CLASSIC:=0}"
# Empty EXPECT_LAF is ONLY valid for classic. A failed/blank helper resolve must not
# make laf_matches() treat Metal as READY for Dark/Light.
if [ "${EXPECT_CLASSIC}" = "1" ]; then
    EXPECT_LAF=""
else
    : "${EXPECT_LAF:=flatdark}"
fi

# Request the FlatLaf themes extension in JD's update registry. The design-install
# dialog only ever existed because the GUI installer requested this extension
# interactively — with the request pre-recorded, the UPDATER installs it like any
# other package: during the headless pre-install on fresh setups, or on the next
# periodic update check of an existing install that is missing it. Ground truth
# from JD source: LookAndFeelType maps every FlatLaf theme to extension id
# "flatlaf-themes"; the request list is a PLAIN JSON ARRAY at
# update/versioninfo/JD/extensions.requestedinstalls.json (the same sanctioned
# path other JD Docker images use). Idempotent; no-op once flatlaf.jar exists.
seed_flatlaf_request() {
    [ -z "${EXPECT_LAF}" ] && return 0
    # Parked-for-classic does not count — we still need a live flatlaf.jar for Dark/Light.
    [ -f "${JD_DIR}/libs/laf/flatlaf.jar" ] && return 0
    python3 - "${JD_DIR}/update/versioninfo/JD/extensions.requestedinstalls.json" <<'PYEOF' >&2 || true
import json, os, sys
path = sys.argv[1]
ids = []
if os.path.exists(path):
    try:
        ids = json.load(open(path))
        if not isinstance(ids, list):
            ids = []
    except Exception:
        ids = []
if "flatlaf-themes" not in ids:
    ids.append("flatlaf-themes")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    json.dump(ids, open(path, "w"))
    print("[jdownloader-autostart] requested flatlaf-themes extension install (the updater will fetch it)")
else:
    # Already requested but jar still missing (e.g. switch JDDEFAULT→Light on a
    # classic-only install). Re-touch the file mtime so operators see activity;
    # the updater already has the id.
    print("[jdownloader-autostart] flatlaf-themes already requested — waiting for flatlaf.jar (avoids Metal until it arrives)")
PYEOF
}

# Classic JDDEFAULT needs synthetica.jar (+ optional skins). License alone is not
# enough: without the jars SyntheticaHelper/JDDefaultLookAndFeel fails and JD
# falls back to MetalLookAndFeel.
#
# Extension IDs (cited from upstream JD):
#   - LookAndFeelType optional Synthetica skins -> extensionID "synthetica-themes"
#   - LookAndFeelType.DEFAULT -> extensionID null (DEFAULT does not map to an install ID)
#   - libs/laf/synthetica.dep.json -> package id "synthetica" for synthetica.jar itself
# We request both so the updater fetches core jar + skins; DEFAULT's enum ID stays null.
seed_synthetica_request() {
    [ "${EXPECT_CLASSIC}" = "1" ] || return 0
    # Only skip seeding when a VALID jar exists — truncated leftovers must not block re-request.
    if [ -f "${HELPERS}" ]; then
        python3 "${HELPERS}" any-synthetica-valid "${JD_DIR}/libs/laf" && return 0
        python3 "${HELPERS}" seed-synthetica \
            "${JD_DIR}/update/versioninfo/JD/extensions.requestedinstalls.json" >&2 || true
        return 0
    fi
    ls "${JD_DIR}/libs/laf"/synthetica*.jar >/dev/null 2>&1 && return 0
    python3 - "${JD_DIR}/update/versioninfo/JD/extensions.requestedinstalls.json" <<'PYEOF' >&2 || true
import json, os, sys
path = sys.argv[1]
ids = []
if os.path.exists(path):
    try:
        ids = json.load(open(path))
        if not isinstance(ids, list):
            ids = []
    except Exception:
        ids = []
changed = False
for ext in ("synthetica", "synthetica-themes"):
    if ext not in ids:
        ids.append(ext)
        changed = True
if changed:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    json.dump(ids, open(path, "w"))
    print("[jdownloader-autostart] requested synthetica extension(s) for classic JDDEFAULT")
PYEOF
}

# True when flatlaf.jar is a readable zip that actually CONTAINS the FlatLaf
# classes. Existence is not enough: a truncated write (e.g. the pre-install kill
# chain stopping the updater mid-download) leaves a jar that every boot fails
# with ClassNotFoundException: com.formdev.flatlaf.FlatDarkLaf -> light GUI.
flatlaf_jar_valid() {
    if [ -f "${HELPERS}" ]; then
        python3 "${HELPERS}" flatlaf-valid "$1"
        return $?
    fi
    python3 - "$1" <<'PYEOF'
import sys, zipfile
try:
    z = zipfile.ZipFile(sys.argv[1])
    z.getinfo("com/formdev/flatlaf/FlatDarkLaf.class")
    sys.exit(1 if z.testzip() is not None else 0)
except Exception:
    sys.exit(1)
PYEOF
}

# Same integrity contract for synthetica*.jar (truncated mid-download → Metal forever).
synthetica_jar_valid() {
    if [ -f "${HELPERS}" ]; then
        python3 "${HELPERS}" synthetica-valid "$1"
        return $?
    fi
    python3 - "$1" <<'PYEOF'
import sys, zipfile
try:
    z = zipfile.ZipFile(sys.argv[1])
    z.getinfo("de/javasoft/plaf/synthetica/SyntheticaLookAndFeel.class")
    sys.exit(1 if z.testzip() is not None else 0)
except Exception:
    sys.exit(1)
PYEOF
}

any_synthetica_valid() {
    if [ -f "${HELPERS}" ]; then
        python3 "${HELPERS}" any-synthetica-valid "${JD_DIR}/libs/laf"
        return $?
    fi
    for j in "${JD_DIR}/libs/laf"/synthetica*.jar; do
        [ -f "${j}" ] || continue
        synthetica_jar_valid "${j}" && return 0
    done
    return 1
}

# Remove a corrupt flatlaf.jar and deregister the extension so seeding re-arms
# and the updater fetches a fresh copy. Without this the broken jar satisfies
# every "is it installed?" check forever and the GUI stays permanently light
# (CI probe ground truth + matching forum field report).
heal_invalid_flatlaf() {
    [ -z "${EXPECT_LAF}" ] && return 0
    jar="${JD_DIR}/libs/laf/flatlaf.jar"
    [ -f "${jar}" ] || return 0
    flatlaf_jar_valid "${jar}" && return 0
    echo "[jdownloader-autostart] INVALID flatlaf.jar detected (truncated install?) — removing it and re-requesting the theme extension" >&2
    rm -f "${jar}"
    python3 - "${JD_DIR}/update/versioninfo/JD/extensions.installed.json" <<'PYEOF' >&2 || true
import json, os, sys
path = sys.argv[1]
if os.path.exists(path):
    try:
        ids = json.load(open(path))
        if isinstance(ids, list) and "flatlaf-themes" in ids:
            ids.remove("flatlaf-themes")
            json.dump(ids, open(path, "w"))
            print("[jdownloader-autostart] deregistered the broken flatlaf-themes install")
    except Exception:
        pass
PYEOF
}

# Mirror FlatLaf heal for classic: only the CORE synthetica.jar is validated.
# Skin/asset jars (syntheticaJDCustom.jar, syntheticaSimple2D.jar, …) do not contain
# SyntheticaLookAndFeel.class — deleting them as "truncated" broke exposeSynthetica.
heal_invalid_synthetica() {
    [ "${EXPECT_CLASSIC}" = "1" ] || return 0
    jar="${JD_DIR}/libs/laf/synthetica.jar"
    [ -f "${jar}" ] || return 0
    synthetica_jar_valid "${jar}" && return 0
    echo "[jdownloader-autostart] INVALID synthetica.jar detected (truncated install?) — removing" >&2
    rm -f "${jar}"
    if [ -f "${HELPERS}" ]; then
        python3 "${HELPERS}" deregister-synthetica \
            "${JD_DIR}/update/versioninfo/JD/extensions.installed.json" >&2 || true
    fi
    echo "[jdownloader-autostart] deregistered broken synthetica extension(s); re-requesting" >&2
    seed_synthetica_request
}

# Official JD ships cfg/synthetica-license.key inside JDownloader.jar. SyntheticaHelper
# REQUIRES that resource (or the same path on disk under JD home). Without it, classic
# LookAndFeelType.DEFAULT (JD_THEME=JDDEFAULT) throws and LookAndFeelController falls
# back to the system LAF — on Linux that is javax.swing.plaf.metal.MetalLookAndFeel.
# FlatLaf themes do not need this key, so we only extract when classic is selected.
# Application.getRessourceURL / JarEntry: cfg/synthetica-license.key in JDownloader.jar.
ensure_synthetica_license() {
    [ "${EXPECT_CLASSIC}" = "1" ] || return 0
    dest="${JD_DIR}/cfg/synthetica-license.key"
    rm -f /tmp/.jd-synthetica-license-missing
    if [ -s "${dest}" ]; then
        return 0
    fi
    [ -f "${LAUNCHER}" ] || {
        echo "[jdownloader-autostart] ERROR: classic JDDEFAULT needs synthetica-license.key but JDownloader.jar is missing" >&2
        : > /tmp/.jd-synthetica-license-missing
        return 1
    }
    mkdir -p "${JD_DIR}/cfg"
    python3 - "${dest}" "${LAUNCHER}" "${JD_DIR}/Core.jar" <<'PYEOF' >&2 || true
import os, sys, zipfile
dest = sys.argv[1]
entry = "cfg/synthetica-license.key"
for jar in sys.argv[2:]:
    if not os.path.isfile(jar):
        continue
    try:
        with zipfile.ZipFile(jar) as z:
            if entry not in z.namelist():
                continue
            data = z.read(entry)
        if not data or len(data) < 32:
            continue
        with open(dest, "wb") as out:
            out.write(data)
        print("[jdownloader-autostart] extracted synthetica-license.key from %s (%d bytes) — required for classic JDDEFAULT" % (os.path.basename(jar), len(data)))
        sys.exit(0)
    except Exception as e:
        print("[jdownloader-autostart] license extract failed from %s: %s" % (os.path.basename(jar), e))
print("[jdownloader-autostart] ERROR: cfg/synthetica-license.key missing after extract — classic JDDEFAULT will fall back to Java Metal (marker: /tmp/.jd-synthetica-license-missing)")
sys.exit(1)
PYEOF
    if [ -s "${dest}" ]; then
        rm -f /tmp/.jd-synthetica-license-missing
        return 0
    fi
    : > /tmp/.jd-synthetica-license-missing
    return 1
}

# Download bootstrap JAR if not yet present in config volume. Retried + zip-validated
# (a captive portal / DNS hijack yields an HTML page, not a jar); on final failure keep
# a LOUD persistent error in the log instead of exiting silently (exit 1 left an empty
# desktop with no hint what happened).
if [ ! -f "${LAUNCHER}" ]; then
    echo "[jdownloader-autostart] Downloading JDownloader launcher to ${JD_DIR}" >&2
    mkdir -p "${JD_DIR}"
    dl_ok=0
    for attempt in 1 2 3; do
        if wget -q -O "${LAUNCHER}.tmp" "https://installer.jdownloader.org/JDownloader.jar" \
           && python3 -c "import sys,zipfile; zipfile.ZipFile(sys.argv[1]).namelist()" "${LAUNCHER}.tmp" 2>/dev/null; then
            mv "${LAUNCHER}.tmp" "${LAUNCHER}"
            dl_ok=1
            break
        fi
        rm -f "${LAUNCHER}.tmp"
        echo "[jdownloader-autostart] download attempt ${attempt}/3 failed (network/DNS/invalid file) — retrying in 10s" >&2
        sleep 10
    done
    if [ "${dl_ok}" != "1" ]; then
        while true; do
            echo "  ###########################################################" >&2
            echo "   ERROR: could not download JDownloader.jar after 3 attempts." >&2
            echo "   Check the container's network/DNS, then RESTART the container." >&2
            echo "  ###########################################################" >&2
            sleep 60
        done
    fi
fi
ensure_synthetica_license
if [ "${EXPECT_CLASSIC}" = "1" ] && [ ! -s "${JD_DIR}/cfg/synthetica-license.key" ]; then
    echo "[jdownloader-autostart] ERROR: classic theme selected but synthetica license is missing — continuing boot (Dark/Light unaffected)" >&2
fi

# ---------------------------------------------------------------------------
# v3 Architecture A ("headless pre-install"). On a FRESH install, run JD's whole
# updater chain ONCE without a GUI first: where no GUI exists, no forced dialog
# can appear, so the core install (launcher -> rescue updater -> Core.jar + libs)
# happens silently and the later GUI first start comes up in seconds instead of
# minutes of black WebUI with a hidden dialog cascade. Verified empirically
# (CI experiment, actions run 29204384382): the headless chain completes the
# core install (~4 min), never prompts on stdin, does NOT install the FlatLaf
# themes extension (its trigger needs the GUI — the design-install dialog on
# the first GUI start remains, auto-confirmed by the agent), and ends in a
# RUNNING headless daemon that must be stopped before the GUI phase can take
# the JD2 single-instance lock. JAVA_TOOL_OPTIONS is not exported yet, so this
# JVM runs without the agent — nothing to click headless anyway.
if [ ! -f "${JD_DIR}/Core.jar" ]; then
    echo "[jdownloader-autostart] fresh install: silent headless pre-install (no GUI = no dialogs; ~3-5 min)..." >&2
    rm -f /tmp/.jd-agent.pid /tmp/.jd-laf-applied /tmp/.jd-laf-restart-request
    # Pre-request the theme extension this JD_THEME needs (FlatLaf OR Synthetica).
    if [ -n "${EXPECT_LAF}" ]; then
        seed_flatlaf_request
    else
        seed_synthetica_request
    fi
    java -Djava.awt.headless=true -jar "${LAUNCHER}" < /dev/null >> /config/jd-headless-install.log 2>&1 &
    # Settle = Core.jar + build.json, AND the theme jars this JD_THEME needs
    # (FlatLaf for Dark/Light, synthetica.jar for classic JDDEFAULT). Without that
    # wait, GUI starts on Metal because SyntheticaHelper has no jars yet.
    tries=0
    settle=0
    while [ "${tries}" -lt 90 ]; do
        sleep 10
        tries=$((tries + 1))
        theme_ok=0
        if [ -n "${EXPECT_LAF}" ]; then
            flatlaf_jar_valid "${JD_DIR}/libs/laf/flatlaf.jar" && theme_ok=1
        elif [ "${EXPECT_CLASSIC}" = "1" ]; then
            any_synthetica_valid && theme_ok=1
        else
            theme_ok=1
        fi
        if [ -f "${JD_DIR}/Core.jar" ] && [ -f "${JD_DIR}/build.json" ] && [ "${theme_ok}" = "1" ]; then
            settle=$((settle + 1))
        else
            settle=0
        fi
        [ "${settle}" -ge 3 ] && break
    done
    if [ "${settle}" -ge 3 ]; then
        echo "[jdownloader-autostart] headless pre-install complete — stopping the headless daemon, starting the GUI" >&2
    else
        echo "[jdownloader-autostart] headless pre-install did not settle within 15 min — falling back to the GUI installer" >&2
    fi
    # Stop the whole detached chain politely (TERM -> wait -> KILL leftovers).
    # "JDownloader\.jar" matches every stage (launcher, JDU relaunch, Core run)
    # but not the python helpers / -javaagent path (they lack the .jar suffix).
    pkill -TERM -f "JDownloader\.jar" 2>/dev/null || true
    w=0
    while pgrep -f "JDownloader\.jar" > /dev/null 2>&1 && [ "${w}" -lt 12 ]; do
        sleep 5
        w=$((w + 1))
    done
    pkill -KILL -f "JDownloader\.jar" 2>/dev/null || true
    rm -f /tmp/.jd-agent.pid /tmp/.jd-laf-applied /tmp/.jd-laf-restart-request
fi

echo "" >&2
echo "  ============================================================" >&2
echo "   JDownloader is starting." >&2
echo "   The FIRST start installs JDownloader + its dark theme and" >&2
echo "   can take a few minutes — most of it as a silent headless" >&2
echo "   pre-install while the WebUI shows an empty dark desktop." >&2
echo "   Do NOT restart the container. Wait for the READY banner below." >&2
echo "  ============================================================" >&2
echo "" >&2

# The READY marker must be cleared on EVERY boot — /tmp persists across
# docker stop/start, and a leftover marker would make the watcher below exit
# immediately so the READY banner would only ever fire on the first boot.
# Same for the agent's ground-truth markers: a stale .jd-laf-applied from the
# previous run would make READY lie about THIS run.
rm -f /tmp/.jd-ready /tmp/.jd-agent.pid /tmp/.jd-laf-applied /tmp/.jd-laf-restart-request

# Ground-truth helpers (inherited by the subshells below). The agent inside JD's JVM
# writes /tmp/.jd-agent.pid (its JVM pid) and /tmp/.jd-laf-applied (the class name of
# the look-and-feel that is ACTUALLY applied).
agent_alive() {
    p=$(cat /tmp/.jd-agent.pid 2>/dev/null)
    [ -n "${p}" ] && kill -0 "${p}" 2>/dev/null
}
laf_matches() {
    [ -f /tmp/.jd-laf-applied ] || return 1
    # Classic JDDEFAULT: only Synthetica/JDDefault counts. Metal = failed fallback.
    if [ "${EXPECT_CLASSIC}" = "1" ]; then
        if grep -qiE 'synthetica|jddefault' /tmp/.jd-laf-applied 2>/dev/null; then
            return 0
        fi
        return 1
    fi
    # Non-classic: EXPECT_LAF must be set (flatdark/flatlight). Empty must NOT match Metal.
    [ -n "${EXPECT_LAF}" ] || return 1
    grep -qi "${EXPECT_LAF}" /tmp/.jd-laf-applied 2>/dev/null
}
# Polite JD restart: TERM the JVM by its ground-truth pid (shutdown hooks flush the
# settings); pgrep only as a fallback when the agent isn't running.
heal_restart() {
    p=$(cat /tmp/.jd-agent.pid 2>/dev/null)
    if [ -n "${p}" ] && kill -0 "${p}" 2>/dev/null; then
        kill -TERM "${p}" 2>/dev/null || true
    else
        pkill -TERM -f "JDownloader\.jar" 2>/dev/null || true
    fi
}

# Background: announce (loud) when JDownloader is actually up. Permanent watcher:
# after EVERY JD restart (self-update relaunch, heal, crash-restart) it re-verifies
# the new JVM and prints a fresh banner — a field report showed that a single
# once-per-boot banner made a healthy restarted JD look "stuck since 20 minutes"
# because the user had no signal that the restart came up fine again.
(
    # READY gates on GROUND TRUTH from the in-JVM agent: /tmp/.jd-laf-applied carries
    # the class name of the look-and-feel that is ACTUALLY applied. (The pre-v3 check —
    # port 9666 up + patched flatlaf.jar on disk — proved a liar: a pending "restart to
    # apply" dialog left the GUI white while jar+port looked fine and the banner fired
    # anyway. The jar is STOCK now, so there is nothing on disk to check; without a
    # live agent the honest answer is the unverified fallback banner below.)
    up_and_themed() {
        agent_alive && laf_matches
    }
    stable=0
    waited=0
    last_banner_pid=""
    while true; do
        if up_and_themed; then stable=$((stable + 1)); else stable=0; fi
        waited=$((waited + 1))
        cur_pid=$(cat /tmp/.jd-agent.pid 2>/dev/null)
        if [ "${stable}" -ge 4 ] && [ -n "${cur_pid}" ] && [ "${cur_pid}" != "${last_banner_pid}" ]; then
            # VERIFIED: the expected look-and-feel is genuinely applied in THIS JVM.
            : > /tmp/.jd-ready
            last_banner_pid="${cur_pid}"
            waited=0
            # House ASCII banner right above the READY status (brand + ready as
            # the log's final block; stdout redirected into the service log).
            /usr/local/bin/print-banner.sh \
                "JDownloader for Unraid" \
                "Modern dark UI · Selkies · Java 21" \
                >&2 2>/dev/null || true
            # Clean two-line status (house look: no rule/box walls).
            echo "  ✓ JDOWNLOADER IS READY" >&2
            echo "    Open the WebUI via HTTPS on port 3001" >&2
            echo "" >&2
        elif [ ! -f /tmp/.jd-ready ] && [ "${waited}" -ge 120 ]; then
            # UNVERIFIED fallback after ~10 min (first boot only): usable, but say so
            # honestly instead of printing the READY banner (which hid the white-GUI
            # bug from the log).
            : > /tmp/.jd-ready
            echo "" >&2
            echo "  ! JDOWNLOADER IS UP (theme NOT verified)" >&2
            echo "    Open the WebUI via HTTPS on port 3001. If the UI looks wrong," >&2
            echo "    check the log above for [jd-dialog-agent] lines and restart" >&2
            echo "    the container once." >&2
            if [ -n "${EXPECT_LAF}" ] && [ ! -f "${JD_DIR}/libs/laf/flatlaf.jar" ]; then
                echo "    NOTE: the FlatLaf theme was requested but JD never installed" >&2
                echo "    it — the design download may have failed (blocked/slow" >&2
                echo "    network). Check connectivity, then restart the container." >&2
            fi
            echo "" >&2
        fi
        sleep 5
    done
) &

# Background theme-healer (v3). The jar is stock now, so there is no "unpatched jar"
# to watch — instead the healer watches the GROUND TRUTH: if JD runs with a LAF that is
# not the expected one (FlatLaf installed but a pending apply, a wedged dialog, a reset
# after self-update), ONE polite restart applies the LAF recorded in JD's config. Also
# serves the dialog agent's explicit restart request (a LAF dialog with unknown button
# labels). Rate-limited to 3 heals per HOUR (not per lifetime) so it can heal after a
# week-long uptime yet can never become a restart loop.
(
    port_up() {
        python3 -c "import socket,sys; s=socket.socket(); s.settimeout(1); sys.exit(0 if s.connect_ex(('127.0.0.1',9666))==0 else 1)" 2>/dev/null
    }
    # Wait until JD has been up + STABLE (install settled) — API port or agent alive;
    # the stable-check avoids acting during the install's flapping.
    s=0
    while [ "${s}" -lt 3 ]; do
        if port_up || agent_alive; then s=$((s + 1)); else s=0; fi
        sleep 5
    done
    window_start=$(date +%s)
    heals=0
    mismatch=0
    last_pid=""
    pid_age=0
    while true; do
        sleep 8
        now=$(date +%s)
        if [ $((now - window_start)) -ge 3600 ]; then
            window_start=${now}
            heals=0
        fi
        # Per-JVM grace: /tmp/.jd-ready persists for the whole container lifetime, so
        # gating on it protects only the FIRST start. Every LATER start (self-update
        # relaunch, heal, crash-restart) begins with the marker legitimately carrying
        # the JVM-default Metal LAF — on a slow box that startup window exceeded the
        # mismatch threshold and the healer TERMed a healthy starting JD, burning its
        # whole budget (field report: "repeats itself like 3 times"). Track the agent
        # pid and give every NEW JVM ~2 minutes before mismatch counting may begin.
        cur_pid=$(cat /tmp/.jd-agent.pid 2>/dev/null)
        if [ "${cur_pid}" != "${last_pid}" ]; then
            last_pid="${cur_pid}"
            pid_age=0
            mismatch=0
        else
            pid_age=$((pid_age + 1))
        fi
        [ "${heals}" -ge 3 ] && continue
        # Explicit restart request from the dialog agent (LAF dialog, unknown buttons).
        if [ -f /tmp/.jd-laf-restart-request ]; then
            rm -f /tmp/.jd-laf-restart-request
            heals=$((heals + 1)); mismatch=0
            echo "[jdownloader-autostart] dialog agent requested a JD restart (pending look-and-feel) — restarting (${heals}/3 this hour)" >&2
            heal_restart
            sleep 25
            continue
        fi
        # LAF mismatch: agent reports a different LAF than expected. FlatLaf themes
        # require a VALID flatlaf.jar; classic JDDEFAULT requires valid synthetica +
        # license. Never TERM while waiting for the first jar download (Metal would
        # otherwise stick forever after JDDEFAULT→Dark/Light with no FlatLaf yet).
        if [ "${pid_age}" -ge 15 ] && [ -f /tmp/.jd-ready ] && agent_alive && ! laf_matches; then
            if [ -n "${EXPECT_LAF}" ]; then
                if flatlaf_jar_valid "${JD_DIR}/libs/laf/flatlaf.jar"; then
                    mismatch=$((mismatch + 1))
                else
                    seed_flatlaf_request
                    if [ "${_flatlaf_wait_logged:-}" != "${cur_pid}" ]; then
                        _flatlaf_wait_logged="${cur_pid}"
                        echo "[jdownloader-autostart] FlatLaf theme selected but flatlaf.jar not ready yet — waiting (not healing; avoids Metal↔restart loop)" >&2
                    fi
                    mismatch=0
                fi
            elif [ "${EXPECT_CLASSIC}" = "1" ]; then
                syn_ok=0
                lic_ok=0
                any_synthetica_valid && syn_ok=1
                [ -s "${JD_DIR}/cfg/synthetica-license.key" ] && lic_ok=1
                if [ -f "${HELPERS}" ]; then
                    if python3 "${HELPERS}" should-heal-classic \
                            --classic 1 --matches 0 --synthetica "${syn_ok}" \
                            --license "${lic_ok}"; then
                        mismatch=$((mismatch + 1))
                    else
                        if [ "${syn_ok}" != "1" ] || [ "${lic_ok}" != "1" ]; then
                            if [ "${_classic_wait_logged:-}" != "${cur_pid}" ]; then
                                _classic_wait_logged="${cur_pid}"
                                echo "[jdownloader-autostart] classic LAF not ready yet (waiting for valid synthetica*.jar and/or license); not healing" >&2
                            fi
                        fi
                        mismatch=0
                    fi
                elif [ "${syn_ok}" = "1" ] && [ "${lic_ok}" = "1" ]; then
                    # Inline fallback when helpers missing (same gate as should-heal-classic).
                    mismatch=$((mismatch + 1))
                else
                    mismatch=0
                fi
            else
                mismatch=0
            fi
        else
            mismatch=0
        fi
        if [ "${mismatch}" -ge 4 ]; then
            heals=$((heals + 1)); mismatch=0
            echo "[jdownloader-autostart] applied LAF differs from expected (JD_THEME=${JD_THEME:-Dark}) — restarting JD to apply (${heals}/3 this hour)" >&2
            heal_restart
            sleep 25
        fi
    done
) &

echo "[jdownloader-autostart] Starting JDownloader (first start may take a few minutes)" >&2

fast_exits=0
while true; do
    # Flat icon pack (JD_Plain) is only for FlatLaf Dark/Light. Classic JDDEFAULT
    # uses JD's stock glossy icons — do not seed iconsetid=flat material there.
    # Use EXPECT_CLASSIC (helpers already strip/normalize) — never raw JD_THEME tr,
    # which reopened the case/whitespace split-brain (#2).
    if [ "${EXPECT_CLASSIC}" = "1" ]; then
            ensure_synthetica_license
            heal_invalid_synthetica
            seed_synthetica_request
            # Park flatlaf.jar so JD cannot keep applying FlatLaf Light/Dark over classic.
            if [ -f "${JD_DIR}/libs/laf/flatlaf.jar" ]; then
                mv -f "${JD_DIR}/libs/laf/flatlaf.jar" "${JD_DIR}/libs/laf/flatlaf.jar.disabled-for-classic" 2>/dev/null || true
                echo "[jdownloader-autostart] disabled flatlaf.jar (JD_THEME=JDDEFAULT wants classic DEFAULT LAF)" >&2
            fi
            echo "[jdownloader-autostart] libs/laf for classic:" >&2
            ls -la "${JD_DIR}/libs/laf" 2>/dev/null | head -40 >&2 || echo "  (libs/laf missing)" >&2
    else
            # Re-enable FlatLaf jar if a previous classic run disabled it.
            if [ -f "${JD_DIR}/libs/laf/flatlaf.jar.disabled-for-classic" ] && [ ! -f "${JD_DIR}/libs/laf/flatlaf.jar" ]; then
                mv -f "${JD_DIR}/libs/laf/flatlaf.jar.disabled-for-classic" "${JD_DIR}/libs/laf/flatlaf.jar" 2>/dev/null || true
                echo "[jdownloader-autostart] re-enabled flatlaf.jar for FlatLaf theme" >&2
            fi
            # Re-seed the bundled flat icon set before each start. JD resets
            # /config/.../themes during its first install, which would wipe the icons
            # seeded in cont-init; re-applying here keeps iconsetid=flat resolving.
            #
            # NOTE: we deliberately do NOT pre-seed FlatLaf into libs/laf. JD installs and
            # manages the FLATLAF_DARK design itself (the dialog agent auto-confirms the
            # install) and records it in its own registry; pre-seeding our jar made JD never
            # register the design and re-ask every start. Dark chrome = JD's own FlatDarkLaf;
            # dark content = JD's native colorfor* config (jdownloader-theme.sh).
            mkdir -p "${JD_DIR}/themes"
            cp -rf /opt/JDownloader/themes-default/. "${JD_DIR}/themes/" 2>/dev/null || true
    fi

    # Apply theme AFTER FlatLaf heal/seed. Fresh JDDEFAULT installs never fetch
    # flatlaf.jar; switching env to Light/Dark would otherwise write FLATLAF_* with
    # no jar → LookAndFeelController falls back to Metal. Hold classic DEFAULT
    # (Synthetica still on disk) until FlatLaf is valid, then heal restarts into it.
    THEME_APPLY="${JD_THEME:-Dark}"
    if [ -n "${EXPECT_LAF}" ]; then
        heal_invalid_flatlaf
        seed_flatlaf_request
        if ! flatlaf_jar_valid "${JD_DIR}/libs/laf/flatlaf.jar"; then
            if any_synthetica_valid; then
                THEME_APPLY="JDDEFAULT"
                echo "[jdownloader-autostart] JD_THEME=${JD_THEME:-Dark} but flatlaf.jar missing — holding classic DEFAULT until FlatLaf installs (avoids Metal)" >&2
            else
                echo "[jdownloader-autostart] WARNING: FlatLaf theme selected and neither flatlaf.jar nor Synthetica is ready — UI may show Metal until the updater finishes" >&2
            fi
        fi
    fi
    # Re-apply theme before each launch — JD's self-update can reset cfg/laf/*.json,
    # and cont-init alone would lose that race on some boots.
    /usr/local/bin/jdownloader-theme.sh "${THEME_APPLY}" >/dev/null 2>&1 || true

    # Remove SystemTrayExtension JAR if JD's bootstrap installed it. The popup
    # 'tray isn't supported' is triggered by the extension's startup probe; if
    # the JAR is renamed, JD's extension loader skips it and the probe never runs.
    python3 /usr/local/bin/kill-tray-extension.py "${JD_DIR}" 2>/dev/null || true

    # Disable system tray and lock the cfg files read-only so JD's bootstrap
    # installer cannot overwrite them with enabled=true during first-run setup.
    python3 /usr/local/bin/disable-tray.py "${JD_DIR}/cfg" 2>/dev/null || true
    chmod 444 \
        "${JD_DIR}/cfg/org.jdownloader.gui.jdtrayicon.TrayExtension.json" \
        "${JD_DIR}/cfg/org.jdownloader.gui.jdtrayicon.TrayExtensionConfig.json" \
        2>/dev/null || true

    # Disable JD's built-in advertisements (the "Become premium user" banner,
    # premium-alert columns, special-deal popups) so the GUI stays clean and the
    # download graph keeps its full height. JD resets this cfg on install/update,
    # so re-apply before each start. Ad elements only — functional settings untouched.
    python3 /usr/local/bin/jdownloader-noads.py "${JD_DIR}/cfg" 2>/dev/null || true

    # v3: the dark chrome comes from /opt/JDownloader/flatlaf-defaults, registered at
    # runtime through FlatLaf's OFFICIAL registerCustomDefaultsSource API (see the
    # dialog agent). JD's flatlaf.jar stays STOCK — no jar patching, no dep.json
    # rewriting — so JD's integrity check is always satisfied and a self-update cannot
    # reset the chrome theme (our colour source is our own file, not JD's artifact).

    # FlatLaf heal/seed already ran above when EXPECT_LAF is set (before theme apply).

    # Optional frozen-appliance mode: JD_SELFUPDATE=false disables JD's periodic
    # self-update checks. OPT-IN only — the same updater channel also delivers the
    # HOSTER PLUGINS, which go stale within weeks (downloads start failing), and the
    # first install NEEDS the updater, hence the gates: libs/ must exist (core
    # installed) AND, when a FlatLaf theme is expected, flatlaf.jar must already be
    # in place — after the headless pre-install libs/ exists but the themes
    # extension does not yet (it installs on the first GUI start THROUGH the
    # updater; freezing before that would leave the theme permanently missing).
    # Optional frozen-appliance mode: JD_SELFUPDATE=false disables JD's periodic
    # self-update checks. OPT-IN only — the same updater channel also delivers the
    # HOSTER PLUGINS, which go stale within weeks (downloads start failing), and the
    # first install NEEDS the updater, hence the gates: libs/ must exist (core
    # installed) AND the theme jars this JD_THEME needs must already be in place
    # (FlatLaf for Dark/Light; valid synthetica.jar + license for classic). Freezing
    # before that would leave Metal permanently with no path to self-heal.
    if [ "${JD_SELFUPDATE:-true}" = "false" ] && [ -d "${JD_DIR}/libs" ]; then
        _freeze_ok=0
        if [ "${EXPECT_CLASSIC}" = "1" ]; then
            if any_synthetica_valid && [ -s "${JD_DIR}/cfg/synthetica-license.key" ]; then
                _freeze_ok=1
            fi
        elif [ -n "${EXPECT_LAF}" ] && flatlaf_jar_valid "${JD_DIR}/libs/laf/flatlaf.jar"; then
            _freeze_ok=1
        fi
        if [ "${_freeze_ok}" = "1" ]; then
        python3 - "${JD_DIR}/cfg/org.jdownloader.updatev2.UpdateSettings.json" <<'PYEOF' >&2 || true
import json, os, sys
path = sys.argv[1]
d = {}
if os.path.exists(path):
    try:
        d = json.load(open(path))
    except Exception:
        pass
d["autoupdatecheckenabled"] = False
d["installupdatesonexitenabled"] = False
os.makedirs(os.path.dirname(path), exist_ok=True)
json.dump(d, open(path, "w"), indent=2)
print("[jdownloader-autostart] JD_SELFUPDATE=false -> periodic self-update checks disabled")
PYEOF
        fi
        unset _freeze_ok
    fi

    # Revision canary: log which JD core build this launch runs, so drift after a
    # self-update is diagnosable from the container log instead of "looks wrong".
    if [ -f "${JD_DIR}/build.json" ]; then
        rev=$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(', '.join(str(k)+'='+str(v) for k,v in sorted(d.items())[:4]))" "${JD_DIR}/build.json" 2>/dev/null)
        echo "[jdownloader-autostart] JD build: ${rev:-unknown}" >&2
    fi

    # FlatLaf is deliberately NOT forced onto the JVM boot classpath (a boot-classpath
    # jar has a null classloader and FlatLaf's lazy UI-delegate loading then NPEs at
    # FlatLaf.java:817 and crashes JD's GUI in a loop). JD installs + loads the official
    # FlatLaf itself; the dark content comes from JD's native colorfor* config.
    #
    # JAVA_TOOL_OPTIONS carries the dialog agent — it auto-confirms JD's forced
    # first-run / update installer dialogs (UpdateController shows them whenever the GUI
    # is visible, so no config can suppress them) so the user never sees them. It is
    # inherited by JD's relaunched child JVM, where the GUI + dialogs actually live.
    export JAVA_TOOL_OPTIONS="-javaagent:/opt/JDownloader/jd-dialog-agent.jar"

    # Title bar / maximise is handled by an openbox <application> rule (see
    # 10-jdownloader-setup) — openbox only honours decorations at map time, so a
    # runtime _MOTIF_WM_HINTS change via xprop did not work.
    #
    # -Dsun.awt.disablegrab=true fixes the File/Settings/Extras menus closing on
    # mouse-release under the streamed X desktop (Swing's popup X grab; seen on
    # KasmVNC, same mechanism under Selkies/Xvfb). It only works with the
    # old title-bar poller gone — that poller kept stealing focus and re-closing
    # the menus, which previously masked this fix.
    # Fresh ground-truth markers for THIS launch — a crash-looping JD must not
    # inherit the previous JVM's "LAF applied" marker (READY would lie).
    rm -f /tmp/.jd-agent.pid /tmp/.jd-laf-applied /tmp/.jd-laf-restart-request

    launch_ts=$(date +%s)
    echo "[jdownloader-autostart] launching JDownloader JVM (the GUI starts here)..." >&2
    # shellcheck disable=SC2086  # JD_UI_SCALE_OPT is a single optional -D flag (empty = omit it)
    java \
        -Dawt.useSystemAAFontSettings=on \
        -Dswing.aatext=true \
        -Dsun.java2d.opengl=false \
        -Dsun.awt.disablemixing=true \
        -Dsun.awt.disablegrab=true \
        ${JD_UI_SCALE_OPT} \
        -jar "${LAUNCHER}"
    EXIT=$?

    # Unlock the tray cfg files so the next iteration's disable-tray.py can update
    # them. Re-locks happen at the top of the next loop iteration.
    chmod 644 \
        "${JD_DIR}/cfg/org.jdownloader.gui.jdtrayicon.TrayExtension.json" \
        "${JD_DIR}/cfg/org.jdownloader.gui.jdtrayicon.TrayExtensionConfig.json" \
        2>/dev/null || true

    # Remove the tray extension JAR if JD downloaded it during this iteration.
    # The next iteration's pre-start kill will be a no-op then.
    python3 /usr/local/bin/kill-tray-extension.py "${JD_DIR}" 2>/dev/null || true

    run_dur=$(( $(date +%s) - launch_ts ))
    echo "[jdownloader-autostart] JDownloader exited (code ${EXIT}) after ${run_dur}s" >&2

    # Wait briefly — JD may have spawned a self-updated process (SmartRlyExitRequest)
    sleep 5

    # Do not start a second bootstrap while a JD instance is already running (a second
    # instance on the same /config corrupts locks/DB). GROUND TRUTH first: the relaunched
    # JVM's agent writes its own pid to /tmp/.jd-agent.pid at premain. A grace window
    # covers the race where the parent exits before the child's premain has written it;
    # pgrep -f "JDownloader\.jar" stays as the fallback when the agent is absent (match
    # the JVM precisely — a bare "JDownloader" also matches the python tray helpers and
    # the -javaagent path, which would park this loop forever on a non-JD process).
    parked=0
    g=0
    while [ "${g}" -lt 6 ]; do
        p=$(cat /tmp/.jd-agent.pid 2>/dev/null)
        if [ -n "${p}" ] && kill -0 "${p}" 2>/dev/null; then
            echo "[jdownloader-autostart] self-relaunched JD (pid ${p}) is running — waiting for it to stop..." >&2
            while [ -n "${p}" ] && kill -0 "${p}" 2>/dev/null; do
                sleep 10
                p2=$(cat /tmp/.jd-agent.pid 2>/dev/null)
                [ -n "${p2}" ] && p="${p2}"   # follow further self-updates
            done
            parked=1
            break
        fi
        if pgrep -f "JDownloader\.jar" > /dev/null 2>&1; then
            echo "[jdownloader-autostart] another JD instance running (pgrep fallback) — waiting for it to stop..." >&2
            while pgrep -f "JDownloader\.jar" > /dev/null 2>&1; do
                sleep 10
            done
            parked=1
            break
        fi
        g=$((g + 1))
        sleep 3
    done
    [ "${parked}" = "1" ] && echo "[jdownloader-autostart] JD stopped, resuming restart loop" >&2

    # Exit backoff: repeated FAST exits (<60s, no relaunch) mean something is wrong —
    # back off exponentially instead of hammering a 5-second crash loop.
    if [ "${parked}" = "1" ] || [ "${run_dur}" -ge 60 ]; then
        fast_exits=0
    else
        fast_exits=$((fast_exits + 1))
    fi
    if [ "${fast_exits}" -ge 3 ]; then
        delay=$((30 * fast_exits))
        [ "${delay}" -gt 300 ] && delay=300
        echo "[jdownloader-autostart] JD exiting fast repeatedly (${fast_exits}x <60s) — backing off ${delay}s" >&2
        sleep "${delay}"
    fi

    echo "[jdownloader-autostart] Restarting JDownloader..." >&2
done
