#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Unraid passes the template's optional CUSTOM_USER and PASSWORD fields as empty
# variables when they are left blank, and the base's init-nginx turns on basic auth
# whenever PASSWORD is set at all, even to "". That would show a login prompt the
# template promises not to, so the empty values are dropped before init-nginx runs.
# A real password still enables basic auth on the WebUI.
if [ -z "${PASSWORD}" ]; then
  rm -f /run/s6/container_environment/PASSWORD
fi
if [ -z "${CUSTOM_USER}" ]; then
  rm -f /run/s6/container_environment/CUSTOM_USER
fi
