#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# -----------------------------------------------------------------------------
# init-screen-size — settle the screen size BEFORE the X server starts
# -----------------------------------------------------------------------------
# SHARED FILE: byte-identical in every junkerderprovinz image that builds on
# linuxserver/baseimage-selkies. Fix it in one place, copy it to the others.
#
# The template offers the screen size twice: MAX_RES as a dropdown of presets
# and MAX_RES_CUSTOM as a free field, because Unraid turns any variable whose
# Default contains a "|" into a plain <select> with no way to type a value.
# selkies-resolution.sh picks between them; this service writes the result into
# the s6 container environment so svc-xorg sees it.
#
# ORDERING IS THE WHOLE POINT: svc-xorg reads MAX_RES when it builds the Xvfb
# command line, so this must have run first. The file at
# rootfs/etc/s6-overlay/s6-rc.d/svc-xorg/dependencies.d/init-screen-size makes
# s6-rc enforce that; without it the two would be free to start in either order
# and the chosen size would apply on some boots and not others. That single
# dependency is enough: svc-xorg/run is the only file under s6-rc.d/ that
# mentions MAX_RES, so there is no other writer to run after.
# -----------------------------------------------------------------------------
set -e

resolution="$(/usr/local/bin/selkies-resolution.sh)"

mkdir -p /run/s6/container_environment

if [[ -n "${resolution}" ]]; then
    printf "%s" "${resolution}" > /run/s6/container_environment/MAX_RES
    echo "[init-screen-size] screen size for this boot: ${resolution}"
else
    # The docker environment is imported into this directory, so a MAX_RES the
    # script rejected is sitting here already and would reach Xvfb verbatim:
    # X would fail to start and the container would come up with no desktop.
    # Removing the file is what makes the fallback real — the base image then
    # applies its own default. init-nologin deletes an empty PASSWORD from the
    # same directory for the same reason.
    rm -f /run/s6/container_environment/MAX_RES
    echo "[init-screen-size] no usable screen size given, leaving the base image default in place"
fi

exit 0
