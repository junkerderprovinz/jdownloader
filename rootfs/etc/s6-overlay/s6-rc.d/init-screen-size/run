#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Settles the screen size before the X server starts. Shared byte for byte by
# every junkerderprovinz image on linuxserver/baseimage-selkies: fix it in one,
# copy it to the others.
#
# selkies-resolution.sh picks between the MAX_RES dropdown and the
# MAX_RES_CUSTOM field; this writes the result into the s6 container environment.
# svc-xorg reads MAX_RES when it builds the Xvfb command line, and
# svc-xorg/dependencies.d/init-screen-size makes s6-rc run this first. Without
# that the size would apply on some boots and not others. No other file under
# s6-rc.d/ mentions MAX_RES, so that one dependency is enough.
set -e

resolution="$(/usr/local/bin/selkies-resolution.sh)"

mkdir -p /run/s6/container_environment

if [[ -n "${resolution}" ]]; then
    printf "%s" "${resolution}" > /run/s6/container_environment/MAX_RES
    echo "[init-screen-size] screen size for this boot: ${resolution}"
else
    # The docker environment is imported into this directory, so a rejected
    # MAX_RES is already here and would reach Xvfb verbatim and stop X from
    # starting. Removing it lets the base image apply its own default.
    rm -f /run/s6/container_environment/MAX_RES
    echo "[init-screen-size] no usable screen size given, leaving the base image default in place"
fi

exit 0
