#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# JDownloader writes its settings (hidden columns, sort order, widths, link list) to
# cfg/*.json only in its JVM shutdown hook, not on change. The JVM is an openbox
# grandchild outside s6's supervision, so on `docker stop` or restart it would be
# killed before saving. This finish runs when the desktop service goes down: it sends
# SIGTERM to the JVM and waits for the hook, and S6_*_GRACETIME in the Dockerfile
# keeps s6 from killing it first.
#
# The launch loop is stopped with pkill rather than a shutdown flag, because a flag
# checked by autostart races with this script and can keep JD from launching at all.

# The autostart loop goes first: s6 does not supervise it, it outlives the JVM and it
# would relaunch JD mid-shutdown. openbox runs it as
# `sh /config/.config/openbox/autostart`, and its background watchers share that
# command line, so one match stops them all.
pkill -f 'openbox/autostart' 2>/dev/null || true

pids="$(pgrep -f 'JDownloader\.jar' || true)"
if [ -n "${pids}" ]; then
    # shellcheck disable=SC2086
    kill -TERM ${pids} 2>/dev/null || true
    i=0
    while [ "${i}" -lt 120 ]; do
        still=""
        for p in ${pids}; do
            kill -0 "${p}" 2>/dev/null && still="yes"
        done
        [ -z "${still}" ] && break
        sleep 0.2
        i=$((i + 1))
    done
fi

# This file replaces the Selkies base's own svc-de/finish, so its cleanup follows:
# TERM the remaining desktop processes under the pid in /de-pid (openbox and the
# rest) and remove the pid file. JD, the slow one, is already down, so the wait is
# short.
PID_FILE="/de-pid"
if [ -r "${PID_FILE}" ]; then
    PARENT_PID=$(cat "${PID_FILE}")
    if [ -n "${PARENT_PID}" ]; then
        DESKTOP_PIDS=$(pstree -p "${PARENT_PID}" 2>/dev/null | grep -o '([0-9]\+)' | grep -o '[0-9]\+' | grep -v "^${PARENT_PID}$" || true)
        if [ -n "${DESKTOP_PIDS}" ]; then
            echo "${DESKTOP_PIDS}" | xargs --no-run-if-empty kill -TERM -- 2>/dev/null || true
            for _ in $(seq 1 20); do
                alive=""
                for p in ${DESKTOP_PIDS}; do
                    kill -0 "$p" 2>/dev/null && alive="yes" && break
                done
                [ -z "${alive}" ] && break
                sleep 0.25
            done
        fi
    fi
    rm -f "${PID_FILE}"
fi
exit 0
