#!/usr/bin/with-contenv bash
# JDownloader only flushes its settings (column layout, sort, widths, link list, ...)
# in its JVM shutdown hook — AppWork writes cfg/*.json on shutdown, NOT on change. The
# JD java process is a grandchild of openbox (not s6-supervised), so on `docker stop` it
# would be SIGKILLed before saving. When this desktop service goes down, SIGTERM the JVM
# directly and wait for it to exit so its shutdown hook can finish the write.
# The flag tells the autostart loop NOT to relaunch JD while we are shutting down.
touch /tmp/.jd-shutting-down 2>/dev/null || true

pids="$(pgrep -f 'JDownloader\.jar' || true)"
if [ -n "${pids}" ]; then
    # shellcheck disable=SC2086
    kill -TERM ${pids} 2>/dev/null || true
    # Wait (bounded) for the JVM shutdown hooks to flush. S6_*_GRACETIME (Dockerfile)
    # keeps s6 from SIGKILLing us before this completes.
    i=0
    while [ "${i}" -lt 120 ]; do
        still=""
        for p in ${pids}; do
            kill -0 "${p}" 2>/dev/null && still="yes"
        done
        [ -z "${still}" ] && break
        sleep 0.2
        i=$((i + 1))
    done
fi
exit 0
