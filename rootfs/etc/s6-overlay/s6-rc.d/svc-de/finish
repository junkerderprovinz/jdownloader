#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# JDownloader flushes its settings (hidden columns, sort order, widths, link list) ONLY in
# its JVM shutdown hook — it writes cfg/*.json on shutdown, not on change. The JD java
# process is an openbox grandchild (not s6-supervised), so on `docker stop`/`restart` it
# would be SIGKILLed before saving. This finish runs when the desktop service goes down:
# SIGTERM the JVM directly and wait for it to exit so the hook completes. S6_*_GRACETIME
# (Dockerfile) keeps s6 from SIGKILLing us before that.
#
# NOTE: deliberately NO shutdown flag here. An earlier version had the autostart loop check
# a flag and `exit 0`, which raced with this script and stopped JD from launching at all.
# The finish is shutdown-only and never runs at startup, so it cannot affect JD launching.

# Kill the autostart launcher loop FIRST — it is not s6-supervised, survives the JVM,
# and its restart loop would otherwise relaunch JDownloader mid-shutdown. openbox runs
# the loop as `sh /config/.config/openbox/autostart`, and its forked background watchers
# share that cmdline, so matching the path takes out loop + watchers in one go.
pkill -f 'openbox/autostart' 2>/dev/null || true

pids="$(pgrep -f 'JDownloader\.jar' || true)"
if [ -n "${pids}" ]; then
    # shellcheck disable=SC2086
    kill -TERM ${pids} 2>/dev/null || true
    i=0
    while [ "${i}" -lt 120 ]; do
        still=""
        for p in ${pids}; do
            kill -0 "${p}" 2>/dev/null && still="yes"
        done
        [ -z "${still}" ] && break
        sleep 0.2
        i=$((i + 1))
    done
fi
exit 0
