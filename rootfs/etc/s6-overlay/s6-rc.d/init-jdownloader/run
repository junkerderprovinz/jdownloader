#!/usr/bin/with-contenv bash
# s6-rc oneshot — banner only.
# Installation is handled by the autostart (runs with a live DISPLAY).

/usr/local/bin/print-banner.sh \
    "JDownloader for Unraid" \
    "Modern dark UI · KasmVNC · Java 21" \
    2>/dev/null || true

log() { echo "[init-jdownloader] $*"; }
log "JD_LANG=${JD_LANG:-de}  JD_THEME=${JD_THEME:-JD_Plain_Dark}"
log "First start may take up to 5 minutes while JDownloader installs itself."
exit 0
