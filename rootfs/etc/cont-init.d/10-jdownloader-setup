#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Runs synchronously before any service (incl. Selkies/openbox).

log() { echo "[jdownloader-setup] $*"; }

CONFIG_HOME="/config/.config"
JD_DIR="${JD_INST_DIR:-/config/JDownloader}"
JD_CFG="${JD_DIR}/cfg"

# Always sync autostart from image so openbox never reads a stale version
mkdir -p "${CONFIG_HOME}/openbox"
cp -f /defaults/autostart "${CONFIG_HOME}/openbox/autostart"
chmod 0755 "${CONFIG_HOME}/openbox/autostart"
log "autostart synced from /defaults/autostart"

# NOTE: the openbox rc.xml window rules (decor=no + dialog un-maximize) moved to
# the init-jdownloader s6 oneshot — the Selkies base restores rc.xml from its
# .bak on every start AFTER this legacy cont-init stage runs, so a patch here
# would be wiped again each boot. init-jdownloader runs after that restore.

# Ensure cfg dir exists (language/theme scripts seed files here)
mkdir -p "${JD_CFG}"

# Seed the bundled "flat" icon set (JD_Plain / icons8) into the config volume so
# iconsetid=flat resolves from the very first start. JD ships this set but only
# provisions it on GUI selection, so a fresh /config would otherwise fall back to
# wrong icons. (icons8 CC BY-ND 3.0 — bundled verbatim, see flat/.../icons8.license.)
# Skip when JDDEFAULT: classic look uses JD's stock glossy icons, not flat.
# Normalize via the same helpers as autostart (strip + casing) so " JDDEFAULT "
# does not accidentally seed flat icons.
THEMES_SRC="/opt/JDownloader/themes-default"
THEMES_DST="${JD_DIR}/themes"
HELPERS="/usr/local/bin/jdownloader-laf-helpers.py"
_is_classic=0
if [[ -f "${HELPERS}" ]]; then
    _is_classic="$(python3 "${HELPERS}" resolve "${JD_THEME:-Dark}" | awk -F= '/^is_classic=/{print $2; exit}')"
else
    _theme_lc="$(printf '%s' "${JD_THEME:-Dark}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | tr '[:upper:]' '[:lower:]')"
    [[ "${_theme_lc}" == "jddefault" ]] && _is_classic=1
fi
if [[ "${_is_classic}" != "1" && -d "${THEMES_SRC}" ]]; then
    mkdir -p "${THEMES_DST}"
    cp -rf "${THEMES_SRC}/." "${THEMES_DST}/"
    log "bundled flat icon set seeded → ${THEMES_DST}/flat"
elif [[ "${_is_classic}" == "1" ]]; then
    log "JDDEFAULT: skipping flat icon seed (classic stock icons)"
fi
unset _is_classic

# NOTE: FlatLaf is intentionally NOT pre-seeded into libs/laf. JD installs and
# registers the FLATLAF_DARK design itself on first run (one-time prompt); seeding
# our own jar made JD never register it, so it re-asked every start. The Breeze
# chrome is provided by the /opt boot classpath (see autostart), not libs/laf.

# Language
/usr/local/bin/jdownloader-language.sh "${JD_LANG:-en}" || log "language hook failed (non-fatal)"

# Push locale into s6 env so all child processes inherit it
mkdir -p /run/s6/container_environment
if [[ -f /config/.profile.d/jdownloader-lang.sh ]]; then
    _L=$(grep '^export LANG='     /config/.profile.d/jdownloader-lang.sh | head -1 | cut -d= -f2-)
    _A=$(grep '^export LC_ALL='   /config/.profile.d/jdownloader-lang.sh | head -1 | cut -d= -f2-)
    _C=$(grep '^export LANGUAGE=' /config/.profile.d/jdownloader-lang.sh | head -1 | cut -d= -f2-)
    [[ -n "$_L" ]] && printf "%s" "$_L" > /run/s6/container_environment/LANG
    [[ -n "$_A" ]] && printf "%s" "$_A" > /run/s6/container_environment/LC_ALL
    [[ -n "$_C" ]] && printf "%s" "$_C" > /run/s6/container_environment/LANGUAGE
    log "locale → s6 env: LANG=${_L:-unchanged}"
fi

# Theme
/usr/local/bin/jdownloader-theme.sh "${JD_THEME:-JD_Plain_Dark}" || log "theme hook failed (non-fatal)"

# Optional in-container browser for JD's captcha "solve in browser" flow. Firefox is
# baked into the image but INERT unless JD_ENABLE_BROWSER is truthy: only then do we
# wire it as the URL handler (mimeapps default) and tell JD's URL opener a desktop it
# understands. JD's AppWork DesktopSupportLinux only recognises GNOME/KDE/Unity/XFCE;
# XFCE is the one whose browse command is plain xdg-open (GNOME/KDE want gnome-open/
# kde-open, absent here). BROWSER points xdg-open's fallback at ff-launch (not bare
# firefox) so that path also gets the stdio-detached launch. Left off, JD has no
# browser handler and never launches one — zero browser process, exactly as before.
# The opt-in is remembered in a /config sentinel so it survives a container recreate
# (a Docker update): even if the recreated container comes up with the "auto" default
# or without JD_ENABLE_BROWSER at all, the saved choice is re-applied instead of the
# browser silently turning off. Only an explicit false/off is a real opt-out and
# clears the sentinel. The wiring runs on every boot from cont-init.
browser_sentinel=/config/.jd-browser-enabled
wire_browser_on() {
    printf '[Default Applications]\nx-scheme-handler/http=firefox.desktop\nx-scheme-handler/https=firefox.desktop\ntext/html=firefox.desktop\n' \
        > /etc/xdg/mimeapps.list
    printf '%s' "XFCE"                        > /run/s6/container_environment/XDG_CURRENT_DESKTOP
    printf '%s' "/usr/local/bin/ff-launch"    > /run/s6/container_environment/BROWSER
}
wire_browser_off() {
    # Ensure a stale handler from a previously-enabled run can't linger and make
    # JD open a browser after the switch was turned back off.
    rm -f /etc/xdg/mimeapps.list
}
case "${JD_ENABLE_BROWSER,,}" in
    true|yes|1|on)
        wire_browser_on
        : > "${browser_sentinel}"
        log "in-container browser ENABLED (JD_ENABLE_BROWSER) — captcha 'solve in browser' will open Firefox"
        ;;
    false|no|0|off)
        wire_browser_off
        rm -f "${browser_sentinel}"
        log "in-container browser disabled (JD_ENABLE_BROWSER=false) — Firefox captcha solving off"
        ;;
    ""|auto)
        # No explicit choice this boot (the "auto" default, or the variable was dropped
        # by a container recreate): follow the saved opt-in so an update cannot silently
        # turn the browser off.
        if [ -f "${browser_sentinel}" ]; then
            wire_browser_on
            log "in-container browser ENABLED from saved choice (/config) — survives container recreate"
        else
            wire_browser_off
            log "in-container browser disabled (default) — set JD_ENABLE_BROWSER=true to enable Firefox captcha solving"
        fi
        ;;
    *)
        wire_browser_off
        log "in-container browser disabled (unrecognised JD_ENABLE_BROWSER='${JD_ENABLE_BROWSER}') — use true, false or auto"
        ;;
esac

# Default download folder — seed /downloads (the mapped volume) so a fresh install
# writes to the download share, not JD's built-in /config/JDownloader/downloads.
# Only seeds when unset/JD-internal; a user's own GUI choice is preserved.
/usr/local/bin/jdownloader-downloaddir.sh || log "download-dir hook failed (non-fatal)"

# First-run window state: start the main frame MAXIMIZED. Without this a fresh
# install opens JD at its built-in 1024x728 default, leaving black desktop around
# it (JDGui.internalInitLocationAndDimension applies the saved extendedState right
# before setVisible; a WM-maximized frame then tracks Selkies' dynamic desktop
# resize to the browser size). Seed ONLY when absent — JD persists the user's
# real window state here on every shutdown, and that choice must be preserved.
FRAME_STATUS="${JD_CFG}/org.jdownloader.settings.GraphicalUserInterfaceSettings.lastframestatus.json"
if [ ! -f "${FRAME_STATUS}" ]; then
    printf '%s' '{"extendedState":"MAXIMIZED_BOTH","visible":true,"active":true,"focus":true,"locationSet":false,"silentShutdown":false,"width":-1,"height":-1,"x":-1,"y":-1}' > "${FRAME_STATUS}"
    log "seeded first-run window state: maximized"
fi

# ffmpeg/ffprobe paths — the image ships system ffmpeg (apt) because JD does not
# auto-download its own build on Linux; without it YouTube DASH muxing fails and
# JD pops the (kiosk-clipped) "FFmpeg is missing" install dialog. JD usually
# finds it via PATH, but seed the explicit paths once so detection is
# deterministic on the very first start. Seed ONLY when absent — a user's own
# GUI choice is preserved.
FFMPEG_CFG="${JD_CFG}/org.jdownloader.controlling.ffmpeg.FFmpegSetup.binarypath.json"
FFPROBE_CFG="${JD_CFG}/org.jdownloader.controlling.ffmpeg.FFmpegSetup.binarypathprobe.json"
if [[ ! -f "${FFMPEG_CFG}" && -x /usr/bin/ffmpeg ]]; then
    printf '%s' '"/usr/bin/ffmpeg"' > "${FFMPEG_CFG}"
    log "seeded ffmpeg path: /usr/bin/ffmpeg"
fi
if [[ ! -f "${FFPROBE_CFG}" && -x /usr/bin/ffprobe ]]; then
    printf '%s' '"/usr/bin/ffprobe"' > "${FFPROBE_CFG}"
    log "seeded ffprobe path: /usr/bin/ffprobe"
fi

# Disable system tray extension — not supported in containers, would otherwise
# trigger an error popup on every start.
python3 /usr/local/bin/disable-tray.py "${JD_CFG}" 2>/dev/null || \
    log "disable-tray failed (non-fatal)"

# Disable JD's built-in advertisements (banner / premium alerts / special deals)
# so the GUI stays clean and the download graph keeps its full height.
python3 /usr/local/bin/jdownloader-noads.py "${JD_CFG}" 2>/dev/null || \
    log "noads failed (non-fatal)"

# Log cfg files present — helps diagnose config issues
cfg_files=("${JD_CFG}"/*.json)
if [[ -e "${cfg_files[0]}" ]]; then
    log "cfg files: ${cfg_files[*]##*/}"
fi

# Make the mapped /downloads volume writable by the JD user (PUID/PGID).
# Docker creates a MISSING host path as root:root, which the JD user can't write —
# JD then silently falls back to <config>/Downloads. chown only the TOP level (no -R)
# so we never traverse a large share or rewrite files that already live inside it.
# NOTE: numeric PUID/PGID, NOT abc — this legacy cont-init stage runs BEFORE the
# base image's init-adduser remaps abc to PUID/PGID, so `chown abc` would still hit
# the build-time uid 911 and miss e.g. Unraid's PUID=99.
if [[ -d /downloads ]]; then
    chown "${PUID:-911}:${PGID:-911}" /downloads 2>/dev/null || true
    if [ "$(stat -c %u /downloads 2>/dev/null)" = "${PUID:-911}" ]; then
        log "/downloads is owned by the JD user (uid ${PUID:-911})"
    else
        log "WARNING: /downloads is NOT writable by the container user (PUID/PGID)."
        log "         JDownloader will fall back to /config. Fix the host share's owner,"
        log "         e.g. on the Unraid console:  chown nobody:users /mnt/.../<download-share>"
    fi
fi

# Fix ownership (numeric ids — see note above: abc is not yet remapped at this stage)
chown -R "${PUID:-911}:${PGID:-911}" /config 2>/dev/null || true

log "setup done (JD_LANG=${JD_LANG:-en}, JD_THEME=${JD_THEME:-JD_Plain_Dark})"
