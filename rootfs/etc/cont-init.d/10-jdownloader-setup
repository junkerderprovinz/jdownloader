#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Runs synchronously before any service, Selkies and openbox included.

log() { echo "[jdownloader-setup] $*"; }

CONFIG_HOME="/config/.config"
JD_DIR="${JD_INST_DIR:-/config/JDownloader}"
JD_CFG="${JD_DIR}/cfg"

# Dark, which the Unraid template fills in by default, means JD Highlighter Dark; the plain
# Carbon look is plain-dark. The services and the JVM read the canonical name from the
# container environment, so the mapping lives in this one place.
JD_THEME="$(python3 /usr/local/bin/jdownloader-laf-helpers.py canonical "${JD_THEME:-}")"
export JD_THEME
printf '%s' "${JD_THEME}" > /run/s6/container_environment/JD_THEME
log "JD_THEME=${JD_THEME}"

# Copied on every start so openbox never reads a stale autostart.
mkdir -p "${CONFIG_HOME}/openbox"
cp -f /defaults/autostart "${CONFIG_HOME}/openbox/autostart"
chmod 0755 "${CONFIG_HOME}/openbox/autostart"
log "autostart synced from /defaults/autostart"

# The openbox rc.xml window rules live in the init-jdownloader oneshot, because the
# Selkies base restores rc.xml from its .bak after this stage on every start.

mkdir -p "${JD_CFG}"

# Seeds the bundled "flat" icon set (JD_Plain, icons8) so iconsetid=flat resolves from
# the first start. JD ships the set but only provisions it when it is picked in the
# GUI, so a fresh /config would show the wrong icons. The icons are CC BY-ND 3.0 and
# bundled verbatim (see flat/.../icons8.license). Classic JDDEFAULT keeps JD's stock
# icons; the helper normalises the theme like autostart does, so " JDDEFAULT " counts
# as classic too.
THEMES_SRC="/opt/JDownloader/themes-default"
THEMES_DST="${JD_DIR}/themes"
HELPERS="/usr/local/bin/jdownloader-laf-helpers.py"
_is_classic=0
if [[ -f "${HELPERS}" ]]; then
    _is_classic="$(python3 "${HELPERS}" resolve "${JD_THEME:-Dark}" | awk -F= '/^is_classic=/{print $2; exit}')"
else
    _theme_lc="$(printf '%s' "${JD_THEME:-Dark}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | tr '[:upper:]' '[:lower:]')"
    [[ "${_theme_lc}" == "jddefault" ]] && _is_classic=1
fi
if [[ "${_is_classic}" != "1" && -d "${THEMES_SRC}" ]]; then
    mkdir -p "${THEMES_DST}"
    cp -rf "${THEMES_SRC}/." "${THEMES_DST}/"
    log "bundled flat icon set seeded → ${THEMES_DST}/flat"
elif [[ "${_is_classic}" == "1" ]]; then
    log "JDDEFAULT: skipping flat icon seed (classic stock icons)"
fi
unset _is_classic

/usr/local/bin/jdownloader-language.sh "${JD_LANG:-en}" || log "language hook failed (non-fatal)"

# The locale goes into the s6 environment so every child process inherits it.
mkdir -p /run/s6/container_environment
if [[ -f /config/.profile.d/jdownloader-lang.sh ]]; then
    _L=$(grep '^export LANG='     /config/.profile.d/jdownloader-lang.sh | head -1 | cut -d= -f2-)
    _A=$(grep '^export LC_ALL='   /config/.profile.d/jdownloader-lang.sh | head -1 | cut -d= -f2-)
    _C=$(grep '^export LANGUAGE=' /config/.profile.d/jdownloader-lang.sh | head -1 | cut -d= -f2-)
    [[ -n "$_L" ]] && printf "%s" "$_L" > /run/s6/container_environment/LANG
    [[ -n "$_A" ]] && printf "%s" "$_A" > /run/s6/container_environment/LC_ALL
    [[ -n "$_C" ]] && printf "%s" "$_C" > /run/s6/container_environment/LANGUAGE
    log "locale → s6 env: LANG=${_L:-unchanged}"
fi

/usr/local/bin/jdownloader-theme.sh "${JD_THEME:-jd-highlighter-dark}" || log "theme hook failed (non-fatal)"

# Firefox for JD's captcha "solve in browser" flow is in the image but stays unused
# unless JD_ENABLE_BROWSER is truthy. Only then is it the URL handler (mimeapps
# default), and JD's URL opener gets a desktop it understands: AppWork's
# DesktopSupportLinux knows GNOME, KDE, Unity and XFCE, and only XFCE browses with
# plain xdg-open (GNOME and KDE want gnome-open or kde-open, which are missing here).
# BROWSER points xdg-open's fallback at ff-launch rather than bare firefox, so that
# path also gets the stdio-detached launch.
#
# The opt-in is remembered in a /config sentinel, so a recreated container (a Docker
# update) that comes up with the "auto" default or without JD_ENABLE_BROWSER keeps
# the browser. Only an explicit false or off opts out and clears the sentinel.
browser_sentinel=/config/.jd-browser-enabled
wire_browser_on() {
    printf '[Default Applications]\nx-scheme-handler/http=firefox.desktop\nx-scheme-handler/https=firefox.desktop\ntext/html=firefox.desktop\n' \
        > /etc/xdg/mimeapps.list
    printf '%s' "XFCE"                        > /run/s6/container_environment/XDG_CURRENT_DESKTOP
    printf '%s' "/usr/local/bin/ff-launch"    > /run/s6/container_environment/BROWSER
}
wire_browser_off() {
    # A handler left from an enabled run would still make JD open a browser.
    rm -f /etc/xdg/mimeapps.list
}
case "${JD_ENABLE_BROWSER,,}" in
    true|yes|1|on)
        wire_browser_on
        : > "${browser_sentinel}"
        log "in-container browser ENABLED (JD_ENABLE_BROWSER): captcha 'solve in browser' will open Firefox"
        ;;
    false|no|0|off)
        wire_browser_off
        rm -f "${browser_sentinel}"
        log "in-container browser disabled (JD_ENABLE_BROWSER=false), Firefox captcha solving off"
        ;;
    ""|auto)
        # No explicit choice on this boot, so the saved opt-in decides.
        if [ -f "${browser_sentinel}" ]; then
            wire_browser_on
            log "in-container browser ENABLED from saved choice (/config), survives container recreate"
        else
            wire_browser_off
            log "in-container browser disabled (default); set JD_ENABLE_BROWSER=true to enable Firefox captcha solving"
        fi
        ;;
    *)
        wire_browser_off
        log "in-container browser disabled (unrecognised JD_ENABLE_BROWSER='${JD_ENABLE_BROWSER}'), use true, false or auto"
        ;;
esac

# Points a fresh install at the mapped /downloads instead of JD's built-in
# /config/JDownloader/downloads, leaving a folder the user picked alone.
/usr/local/bin/jdownloader-downloaddir.sh || log "download-dir hook failed (non-fatal)"

# The Selkies web desktop drops uploads into $FILE_MANAGER_PATH. JD's folderwatchV2
# extension imports link containers (.dlc, .ccf, .rsdf) and .crawljob files from
# there, so a dropped .dlc ends up in the LinkGrabber. The switch is only seeded
# when missing, so turning it off in the GUI sticks.
WATCH_DIR="${JD_WATCH_DIR:-${FILE_MANAGER_PATH:-/config/Desktop}}"
mkdir -p "${WATCH_DIR}"
FOLDERWATCH_CFG="${JD_CFG}/org.jdownloader.extensions.folderwatchV2.FolderWatchExtension.json"
FOLDERWATCH_FOLDERS="${JD_CFG}/org.jdownloader.extensions.folderwatchV2.FolderWatchExtension.folders.json"
if [ ! -f "${FOLDERWATCH_CFG}" ]; then
    python3 - "${FOLDERWATCH_CFG}" <<'PYEOF'
import json, sys
# freshinstall=false keeps JD's first run from resetting "enabled" to the
# extension default. Keys are the lowercased getter names.
path = sys.argv[1]
json.dump({"enabled": True, "freshinstall": False, "checkinterval": 5000, "debugenabled": False},
          open(path, "w"), indent=2)
print("[jdownloader-setup] folderwatch enabled -> %s" % path)
PYEOF
fi
# AppWork's StorageHandler keeps array getters in their own <Class>.<key>.json, and a
# "folders" key in the main file is ignored. Appending keeps folders the user added.
python3 - "${FOLDERWATCH_FOLDERS}" "${WATCH_DIR}" <<'PYEOF'
import json, os, sys
path, watch = sys.argv[1], sys.argv[2]
folders = []
if os.path.exists(path):
    try:
        folders = json.load(open(path))
        if not isinstance(folders, list):
            folders = []
    except Exception:
        folders = []
if watch not in folders:
    folders.append(watch)
    json.dump(folders, open(path, "w"), indent=2)
    print("[jdownloader-setup] folderwatch watching -> %s (%s)" % (watch, path))
PYEOF

# A fresh install would open JD at its built-in 1024x728 with black desktop around it.
# JDGui.internalInitLocationAndDimension applies the saved extendedState right before
# setVisible, and a frame maximised by the window manager then follows Selkies'
# desktop resize to the browser size. JD saves the real window state here on every
# shutdown, so this is only written when the file is missing.
FRAME_STATUS="${JD_CFG}/org.jdownloader.settings.GraphicalUserInterfaceSettings.lastframestatus.json"
if [ ! -f "${FRAME_STATUS}" ]; then
    printf '%s' '{"extendedState":"MAXIMIZED_BOTH","visible":true,"active":true,"focus":true,"locationSet":false,"silentShutdown":false,"width":-1,"height":-1,"x":-1,"y":-1}' > "${FRAME_STATUS}"
    log "seeded first-run window state: maximized"
fi

# JD does not download its own ffmpeg on Linux, so the image ships the system one;
# without it YouTube DASH muxing fails and JD opens its "FFmpeg is missing" dialog. JD
# usually finds it on PATH, but explicit paths make detection certain on the first
# start. They are only written when missing, so a path set in the GUI stays.
FFMPEG_CFG="${JD_CFG}/org.jdownloader.controlling.ffmpeg.FFmpegSetup.binarypath.json"
FFPROBE_CFG="${JD_CFG}/org.jdownloader.controlling.ffmpeg.FFmpegSetup.binarypathprobe.json"
if [[ ! -f "${FFMPEG_CFG}" && -x /usr/bin/ffmpeg ]]; then
    printf '%s' '"/usr/bin/ffmpeg"' > "${FFMPEG_CFG}"
    log "seeded ffmpeg path: /usr/bin/ffmpeg"
fi
if [[ ! -f "${FFPROBE_CFG}" && -x /usr/bin/ffprobe ]]; then
    printf '%s' '"/usr/bin/ffprobe"' > "${FFPROBE_CFG}"
    log "seeded ffprobe path: /usr/bin/ffprobe"
fi

# jd-highlighter starts with a leaner download list: no "Save to" and "Comment"
# columns, and a wider progress column. ExtTable falls back to each column's default
# for keys that are missing, and JD rewrites the whole file on shutdown, so it is
# only seeded on a fresh install. VISABLE is JD's spelling.
case "${JD_THEME:-Dark}" in
    jd-highlighter|*[Hh]ighlight*)
        DLTABLE_CFG="${JD_CFG}/ExtTable_downloadstable3.json"
        if [ ! -f "${DLTABLE_CFG}" ]; then
            printf '%s' '{"VISABLE_COL_ExtTextColumn.org.jdownloader.gui.views.downloads.columns.DownloadFolderColumn":false,"VISABLE_COL_ExtTextAreaColumn.org.jdownloader.gui.views.components.packagetable.columns.CommentColumn":false,"WIDTH_COL_ExtProgressColumn.org.jdownloader.gui.views.downloads.columns.ProgressColumn":260}' > "${DLTABLE_CFG}"
            log "seeded downloads-table columns: hide Save to and Comment, progress width 260"
        fi
        ;;
esac

# A container has no system tray, and the extension would raise an error popup on
# every start.
python3 /usr/local/bin/disable-tray.py "${JD_CFG}" 2>/dev/null || \
    log "disable-tray failed (non-fatal)"

# Turns off JD's advertising (banner, premium alerts, special deals), which also
# gives the download graph its full height.
python3 /usr/local/bin/jdownloader-noads.py "${JD_CFG}" 2>/dev/null || \
    log "noads failed (non-fatal)"

cfg_files=("${JD_CFG}"/*.json)
if [[ -e "${cfg_files[0]}" ]]; then
    log "cfg files: ${cfg_files[*]##*/}"
fi

# Docker creates a missing host path as root:root, which the JD user cannot write,
# and JD then falls back to <config>/Downloads without a word. Only the top level is
# chowned, so a large share is never traversed and the files in it keep their owner.
# The ids are numeric because this cont-init stage runs before the base's
# init-adduser remaps abc to PUID/PGID; `chown abc` would still hit the build-time
# uid 911 and miss Unraid's PUID=99.
if [[ -d /downloads ]]; then
    chown "${PUID:-911}:${PGID:-911}" /downloads 2>/dev/null || true
    if [ "$(stat -c %u /downloads 2>/dev/null)" = "${PUID:-911}" ]; then
        log "/downloads is owned by the JD user (uid ${PUID:-911})"
    else
        log "WARNING: /downloads is NOT writable by the container user (PUID/PGID)."
        log "         JDownloader will fall back to /config. Fix the host share's owner,"
        log "         e.g. on the Unraid console:  chown nobody:users /mnt/.../<download-share>"
    fi
fi

chown -R "${PUID:-911}:${PGID:-911}" /config 2>/dev/null || true
# autostart renders the FlatLaf defaults again before every JD start, as the app user, so an
# accent or variant picked in JD's settings shows after JD restarts.
chown -R "${PUID:-911}:${PGID:-911}" /opt/JDownloader/flatlaf-defaults 2>/dev/null || true

log "setup done (JD_LANG=${JD_LANG:-en}, JD_THEME=${JD_THEME:-jd-highlighter-dark})"
