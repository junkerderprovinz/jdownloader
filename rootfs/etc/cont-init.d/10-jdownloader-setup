#!/usr/bin/with-contenv bash
# Runs synchronously before any service (incl. KasmVNC/openbox).

log() { echo "[jdownloader-setup] $*"; }

CONFIG_HOME="/config/.config"
JD_DIR="${JD_INST_DIR:-/config/JDownloader}"
JD_CFG="${JD_DIR}/cfg"

# Always sync autostart from image so openbox never reads a stale version
mkdir -p "${CONFIG_HOME}/openbox"
cp -f /defaults/autostart "${CONFIG_HOME}/openbox/autostart"
chmod 0755 "${CONFIG_HOME}/openbox/autostart"
log "autostart synced from /defaults/autostart"

# Ensure cfg dir exists (language/theme scripts seed files here)
mkdir -p "${JD_CFG}"

# Copy bundled themes from image into config volume
THEMES_SRC="/opt/JDownloader/themes-default"
THEMES_DST="${JD_DIR}/themes"
if [[ -d "${THEMES_SRC}" ]]; then
    mkdir -p "${THEMES_DST}"
    cp -rf "${THEMES_SRC}/." "${THEMES_DST}/"
    log "bundled themes copied → ${THEMES_DST}"
fi

# Pre-seed patched FlatLaf 3.7 (Breeze Dark) into JD's libs/laf/ so no install dialog appears.
# AWU checks hash in dep.json — we compute it from our patched JAR so JD considers it "installed".
FLATLAF_SRC="/opt/JDownloader/flatlaf.jar"
FLATLAF_LIB="${JD_DIR}/libs/laf"
if [[ -f "${FLATLAF_SRC}" ]]; then
    mkdir -p "${FLATLAF_LIB}"
    cp -f "${FLATLAF_SRC}" "${FLATLAF_LIB}/flatlaf.jar"
    python3 - <<PYEOF 2>/dev/null || true
import hashlib, json
jar = "${FLATLAF_LIB}/flatlaf.jar"
with open(jar, "rb") as f:
    sha256 = hashlib.sha256(f.read()).hexdigest()
dep = {
    "artefact": "com.formdev/flatlaf",
    "installed": {
        "date": "2025-12-11T14:11:30.883+01:00",
        "description": "Flat Look and Feel",
        "hashes": {"flatlaf.jar": sha256},
        "licenses": [{"name": "The Apache License, Version 2.0",
                       "url": "https://www.apache.org/licenses/LICENSE-2.0.txt"}],
        "minJRE": "JVM_1_8",
        "name": "FlatLaf",
        "version": "3.7"
    },
    "minJRE": "1.8",
    "provider": "maven",
    "requiredBy": [],
    "autoRenameEnabled": True,
    "confirm": True
}
with open("${FLATLAF_LIB}/flatlaf.dep.json", "w") as f:
    json.dump(dep, f, indent=2)
print("[jdownloader-setup] FlatLaf 3.7 (Breeze Dark) pre-seeded → ${FLATLAF_LIB}/flatlaf.dep.json hash=" + sha256[:12] + "...")
PYEOF
    log "FlatLaf pre-seeded → ${FLATLAF_LIB}/flatlaf.jar"
fi

# Build full JD_Plain_Dark: JD_Plain icons + Breeze Dark colours
# (creates full copy with icons if JD_Plain is already installed, else colour-only stub)
/usr/local/bin/jdownloader-create-dark-theme.py \
    || log "create-dark-theme: JD_Plain not yet installed, stub written"

# Seed themes/FLATLAF_DARK/ = JD_Plain icons + Breeze Dark colours, named FLATLAF_DARK
# JD discovers this directory on startup and treats the theme as already installed
python3 - <<PYEOF 2>/dev/null || true
import json, os, shutil
src = "${THEMES_DST}/JD_Plain_Dark"
dst = "${THEMES_DST}/FLATLAF_DARK"
if os.path.isdir(src):
    if os.path.isdir(dst):
        shutil.rmtree(dst)
    shutil.copytree(src, dst)
    tj = os.path.join(dst, "theme.json")
    if os.path.exists(tj):
        with open(tj) as f:
            d = json.load(f)
        d["id"]   = "FLATLAF_DARK"
        d["name"] = "FlatLaf Dark"
        d.pop("parent", None)
        with open(tj, "w") as f:
            json.dump(d, f, indent=2)
    print("[jdownloader-setup] themes/FLATLAF_DARK ← JD_Plain_Dark (Breeze Dark, full)")
else:
    print("[jdownloader-setup] JD_Plain_Dark not ready, FLATLAF_DARK not seeded yet")
PYEOF

# Language
/usr/local/bin/jdownloader-language.sh "${JD_LANG:-de}" || log "language hook failed (non-fatal)"

# Push locale into s6 env so all child processes inherit it
mkdir -p /run/s6/container_environment
if [[ -f /config/.profile.d/jdownloader-lang.sh ]]; then
    _L=$(grep '^export LANG='     /config/.profile.d/jdownloader-lang.sh | head -1 | cut -d= -f2-)
    _A=$(grep '^export LC_ALL='   /config/.profile.d/jdownloader-lang.sh | head -1 | cut -d= -f2-)
    _C=$(grep '^export LANGUAGE=' /config/.profile.d/jdownloader-lang.sh | head -1 | cut -d= -f2-)
    [[ -n "$_L" ]] && printf "%s" "$_L" > /run/s6/container_environment/LANG
    [[ -n "$_A" ]] && printf "%s" "$_A" > /run/s6/container_environment/LC_ALL
    [[ -n "$_C" ]] && printf "%s" "$_C" > /run/s6/container_environment/LANGUAGE
    log "locale → s6 env: LANG=${_L:-unchanged}"
fi

# Theme
/usr/local/bin/jdownloader-theme.sh "${JD_THEME:-JD_Plain_Dark}" || log "theme hook failed (non-fatal)"

# Disable system tray extension — not supported in containers, causes error popup
# Try both common config file locations; JD reads whichever one exists.
for TRAY_JSON in \
    "${JD_CFG}/org.jdownloader.gui.jdtrayicon.TrayExtension.json" \
    "${JD_CFG}/org.jdownloader.gui.jdtrayicon.TrayExtensionConfig.json"; do
    python3 - <<PYEOF 2>/dev/null || true
import json, os
path = "${TRAY_JSON}"
data = {}
if os.path.exists(path):
    try:
        with open(path) as f:
            data = json.load(f)
    except Exception:
        pass
data["enabled"] = False
with open(path, "w") as f:
    json.dump(data, f, indent=2)
print("[jdownloader-setup] tray disabled → " + path)
PYEOF
done

# Log cfg files present — helps diagnose config issues
if ls "${JD_CFG}"/*.json >/dev/null 2>&1; then
    log "cfg files: $(ls "${JD_CFG}"/*.json | xargs -n1 basename | tr '\n' ' ')"
fi

# Fix ownership
chown -R abc:abc /config 2>/dev/null || true

log "setup done (JD_LANG=${JD_LANG:-de}, JD_THEME=${JD_THEME:-JD_Plain_Dark})"
