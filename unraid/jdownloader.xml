<?xml version="1.0"?>
<Container version="2">
  <Name>JDownloader-Compact</Name>
  <Beta>false</Beta>
  <Repository>ghcr.io/milfer322/jdownloader:latest</Repository>
  <Registry>https://github.com/milfer322/jdownloader/pkgs/container/jdownloader</Registry>
  <Network>bridge</Network>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <ReadMe>https://github.com/milfer322/jdownloader/blob/feat/compact-toolbar/README.md</ReadMe>
  <Support>https://github.com/milfer322/jdownloader/issues</Support>
  <Project>https://jdownloader.org</Project>
  <Overview>
Fork of junkerderprovinz/jdownloader with an optional compact toolbar.&#xD;
&#xD;
Set Compact Toolbar (JD_COMPACT_TOOLBAR) to true to keep JDownloader's stock ~32px toolbar row (less vertical padding around the icons). Leave it false/empty for the upstream default 64px speed-graph row.&#xD;
&#xD;
Everything else matches the upstream image: dark/light theme, Selkies WebUI, auto-install, clipboard over HTTPS.&#xD;
&#xD;
Source: https://github.com/milfer322/jdownloader&#xD;
Upstream: https://github.com/junkerderprovinz/jdownloader&#xD;
  </Overview>
  <Category>Downloaders:</Category>
  <WebUI>https://[IP]:[PORT:3001]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/milfer322/jdownloader/feat/compact-toolbar/unraid/jdownloader.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/jdownloader/icon.png</Icon>
  <ExtraParams>--restart=unless-stopped --shm-size=1gb</ExtraParams>

  <!-- ========================================================
       PORTS
       ======================================================== -->
  <Config Name="WebUI Port (HTTP / Selkies)" Target="3000" Default="3000" Mode="tcp"
          Description="Plain HTTP WebUI. Browsers block seamless clipboard over HTTP — prefer HTTPS (3001)."
          Type="Port" Display="always" Required="false" Mask="false">3000</Config>

  <Config Name="WebUI Port (HTTPS / Selkies)" Target="3001" Default="3001" Mode="tcp"
          Description="HTTPS WebUI (self-signed TLS) — the WebUI button opens this; required for seamless clipboard."
          Type="Port" Display="always" Required="true" Mask="false">3001</Config>

  <!-- ========================================================
       PATHS
       ======================================================== -->
  <Config Name="AppData (/config)" Target="/config" Default="/mnt/user/appdata/jdownloader" Mode="rw"
          Description="Persistent JDownloader install, configs, and session data."
          Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/jdownloader</Config>

  <Config Name="Downloads (/downloads)" Target="/downloads" Default="/mnt/user/downloads" Mode="rw"
          Description="Download target directory."
          Type="Path" Display="always" Required="true" Mask="false">/mnt/user/downloads</Config>

  <!-- ========================================================
       UI PREFERENCES
       ======================================================== -->
  <Config Name="Theme (JD_THEME)" Target="JD_THEME"
          Default="Dark|Light|jd-highlighter" Mode=""
          Description="Dark = monochrome Carbon #161616, Light = JD's light theme, jd-highlighter = borderless, freely-accented dark (pick the accent with JD_ACCENT below)."
          Type="Variable" Display="always" Required="false" Mask="false">Dark</Config>

  <Config Name="Compact Toolbar (JD_COMPACT_TOOLBAR)" Target="JD_COMPACT_TOOLBAR"
          Default="true|false" Mode=""
          Description="true = keep JDownloader's stock ~32px toolbar row (less padding around icons). false = upstream default: grow the speed-graph toolbar row to 64px. Restart the container after changing it."
          Type="Variable" Display="always" Required="false" Mask="false">true</Config>

  <Config Name="Accent (JD_ACCENT)" Target="JD_ACCENT"
          Default="#ffee00" Mode=""
          Description="Accent colour for the jd-highlighter theme (any hex, e.g. #ffee00). Only applies when Theme is set to jd-highlighter. The accent lights up checkmarks, toggles, focus, the download progress bar and primary buttons; large fills stay neutral so text stays readable at any hue. Button/progress text is auto-contrasted (dark on a light accent, light on a dark accent)."
          Type="Variable" Display="advanced" Required="false" Mask="false">#ffee00</Config>

  <Config Name="Self-Update (JD_SELFUPDATE)" Target="JD_SELFUPDATE"
          Default="true|false" Mode=""
          Description="true (default) = JDownloader keeps updating itself. false = frozen appliance: disables JD's periodic self-update checks. WARNING: the same update channel delivers the hoster plugins, which go stale within weeks - downloads may start failing. The first install always uses the updater."
          Type="Variable" Display="advanced" Required="false" Mask="false">true</Config>

  <Config Name="In-container browser for captchas (JD_ENABLE_BROWSER)" Target="JD_ENABLE_BROWSER"
          Default="auto|true|false" Mode=""
          Description="auto (default) = remembers your last choice, so an enabled browser survives container updates (recreates). Set true to enable JDownloader's 'solve captcha in browser' flow: reCAPTCHA/hCaptcha/Turnstile open in a bundled Firefox (with uBlock Origin) on the web desktop and are solved with one click, from the container's own IP (tokens are IP-bound). The Firefox profile persists in /config/.config/mozilla. Set false to force it off. Only enable it if a hoster you use needs browser captchas - classic image captchas are auto-solved either way, and enabling it runs a full browser (more resources + attack surface)."
          Type="Variable" Display="advanced" Required="false" Mask="false">auto</Config>

  <!-- ========================================================
       WEBUI AUTH (SELKIES)
       ======================================================== -->
  <Config Name="WebUI Username" Target="CUSTOM_USER" Default="" Mode=""
          Description="Optional. Username for HTTP-basic-auth. Leave EMPTY with password for no login."
          Type="Variable" Display="always" Required="false" Mask="false"/>

  <Config Name="WebUI Password" Target="PASSWORD" Default="" Mode=""
          Description="Optional. Password for HTTP-basic-auth."
          Type="Variable" Display="always" Required="false" Mask="true"/>

